%%
%% This is file 'pdftexja-jfmglue.sty'.
%% pdfTeX-ja: JFM glue, kinsoku and line-end adjustment
%% (loaded by pdftexja-core.sty; do not load directly).
%%
%% Typesetting rules:
%%   - loads the JFM data ptjfm-<name>.def of the document direction
%%     (package options jfm= / tjfm=; generated from LuaTeX-ja JFM
%%     Lua files by pdftexja-jfmconv.lua)
%%   - per-character state machine on the CJK output layer:
%%     hooks the inner \CJKsymbol (both the plain and the punct route
%%     funnel through it under noCJKpunct) and the CJK@X helpers
%%     (post-glyph peek)
%%   - JFM pair glue (nat/str/shr in zw) between adjacent classes;
%%     undefined JA-JA pair -> kanjiskip, undefined pair with a latin
%%     side (class 27) -> xkanjiskip (LuaTeX-ja fallback)
%%   - JA<->LA boundary: per-character jaxspmode
%%   - kinsoku: per-character pre/postbreakpenalty
%%   - paragraph start resets the state to the JFM boundary class 90
%%     (parbdd); math counts as a latin (alchar) boundary
%%   - priority data (stretch/shrink priority) recorded per boundary,
%%     consumed by pdftexja-adjust.sty; end_adjust line-end candidates
%%
%% Hook surface notes (why these points):
%%   - bxcjkjatype[noCJKpunct] leaves \CJKpunctsymbol = the OUTER
%%     robust shell of \CJKsymbol; every UTF-8 route (2-byte \CJK@char,
%%     3-byte \CJK@altchar, punct-routed \CJK@punctchar) calls
%%     \CJKsymbol{\@tempcnta} with the DECIMAL CODEPOINT. Wrapping the
%%     inner `\CJKsymbol ' (robust command internals) hooks them all.
%%   - CJK's own inter-char glue (\CJKglue / \CJK@nobreakglue) is
%%     neutralized: our pair glue resets \lastkern so their machinery
%%     would never fire after our nodes anyway, and their markers
%%     (\CJK@kern / \CJK@CJK, +-1sp/-2sp net-zero kerns) stay intact
%%     for third-party code. Double spacing is thereby impossible.
%%

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{pdftexja-jfmglue}[2026/10/27 v0.3 pdfTeX-ja JFM glue (experimental)]

\makeatletter

%. ----------------------------------------------------- JFM data load
% \ptj@loadjfm{<name>}: input ptjfm-<name>.def. Only the JFM of the
% document direction is loaded (the data macros are global names).
% Missing data is an explicit error (no silent fallback).
\def\ptj@loadjfm#1{%
  \edef\ptj@jfm@file{ptjfm-#1.def}%
  \IfFileExists{\ptj@jfm@file}{%
    \typeout{pdftexja: JFM data \ptj@jfm@file}%
    \input\ptj@jfm@file
  }{%
    \PackageError{pdftexja}{%
      JFM data file \ptj@jfm@file\space is missing}{%
      pdfTeX-ja reads JFM data generated from a LuaTeX-ja JFM file\MessageBreak
      (jfm-<name>.lua) by pdftexja-jfmconv.lua.\MessageBreak
      \@ehc}%
  }}
\ifptj@tate
  \RequirePackage{graphicx}%
  \ptj@loadjfm{\ptj@opt@tjfm}%
\else
  \ptj@loadjfm{\ptj@opt@jfm}%
\fi
%. ------------------------------------------------------- state machine
% Last-char-class state; values are the generated .def class numbers
% plus two synthetic states:
%   90 = paragraph/box boundary (JFM parbdd/boxbdd pseudo class; pair
%        90->1 is defined {0,0,0}, all other 90->c pairs are undefined
%        and fall back to \ptj@kanjiskip exactly as LuaTeX-ja does)
%   93 = explicit space seen (neutral: no boundary glue across a user
%        space, matching ltj's glue-node handling)
% 27 (latin run / math) is a real JFM class (alchar); pairs with 27
% define the JA<->LA glue, undefined 27 pairs fall back to
% \ptj@xkanjiskip.
% \global everywhere: the CJK layer expands inside {...} groups and the
% state must survive them.
\newcount\ptj@lastclass \global\ptj@lastclass=90
% class of the glyph being processed (scratch, global: hook bodies run
% inside the CJK decoder's own groups)
\newcount\ptj@curclass \global\ptj@curclass=0
% \inhibitglue interlock: 1 = suppress the next pair's glue (consumed
% ONCE by the emitter -- real one-boundary suppression semantics)
\newcount\ptj@inhibit \global\ptj@inhibit=0
% pending post-break penalty of the previous glyph (half of the unified
% boundary penalty p = post(prev)+pre(next); the pre half is added at
% emission time and the SAME p is applied to every legal candidate)
\newcount\ptj@pend \global\ptj@pend=0
% pair glue scratch lengths (zw-scaled sp values)
\newdimen\ptj@nat
\newdimen\ptj@str
\newdimen\ptj@shr
% kanjiskip companion glue (separate node contribution)
\newdimen\ptj@knat
\newdimen\ptj@kstr
\newdimen\ptj@kshr
% codepoint scratch (decimal, from the CJK decoder)
\newcount\ptj@cp \global\ptj@cp=0
% zw of the glyph BEFORE / AT the current boundary (mixed-size blend:
% ltj-jfmglue.lua:812-857 blend_diffmet with the default
% diffmet_rule = two_paverage; both sides carry their own zw)
\newdimen\ptj@zw@prev \global\ptj@zw@prev=1pt
\newdimen\ptj@zw@cur  \global\ptj@zw@cur=1pt
% last observed CJK codepoint (scalar; -1 at paragraph/box boundaries).
% This IS the live \lastnodechar of pdfTeX-ja (public read-only name
% \ptjlastnodechar; \ptjupdatelastnodechar applies the box-boundary
% rule first). It is also the "previous character" of the per-character
% kinsoku/jaxspmode lookups.
\newcount\ptj@lastnodechar \global\ptj@lastnodechar=-1
\let\ptjlastnodechar\ptj@lastnodechar
% codepoint of the glyph at the current boundary (the "next character"
% of the per-character lookups) and the combining-mark flag
\newcount\ptj@curcp \global\ptj@curcp=-1
\newcount\ptj@combo \global\ptj@combo=0
% per-boundary priority data (ptjparagraph prerequisite): recorded
% at every pair emission so the strict-paragraph repack flow can
% read tier priorities without recomputing the lookup.
\newcount\ptj@pairspri
\newcount\ptj@pairshpri
% \ptj@pairspri/@pairshpri hold the pair's stretch / shrink
% priority (0 = plain finite glue); \ptj@knat/@kstr/@kshr
% hold the kanjiskip companion components (0 when the pair's
% kanjiskip_natural/stretch/shrink flags are 0). \ptj@nat/@str/
% @shr hold the JFM pair glue itself. The ptjparagraph module
% reads these registers right after each boundary evaluation.
% Flag: when 1, \ptj@placeglyph boxes EVERY glyph (1zw classes
% too) -- set by the ptjparagraph measurement so line interiors are
% fully walkable (boxes/glues/kerns/penalties only, no bare chars).
\newcount\ptj@boxglyphs \global\ptj@boxglyphs=0

%. --------------------------------------------------- semantic frames
% Box/paragraph boundaries must not inherit (nor leak) the running
% inter-glyph state. Two mechanisms, both WITHOUT
% \aftergroup (see the long comment below):
%   * ENTRY: everyhbox/everyvbox tokens (prepended; the user's own
%     tokens still run exactly once, after ours) neutralize the state
%     at box start (boxbdd semantics: 90/-1/0) so the glyph layer
%     inside starts from the neutral paragraph-boundary state. The
%     inhibit flag is preserved (one-shot semantics: \inhibitglue
%     issued just before a box must still suppress the first eligible
%     boundary INSIDE it). Backend-internal boxes (charbox, math
%     boxes, measurement boxes) bracket the guard count
%     \ptj@nest so this hook is a no-op inside them.
%   * CLOSE: no token is inserted. Reads that directly follow a box
%     (\lastnodetype 13/14 with the glyphmark below clear) re-apply
%     the same neutralization (boxbdd); the direction field of the
%     old frame tuple is gone (the factory and theindex switch
%     direction only inside nest-guarded boxes or outside boxes).
% NOTE: the old design saved the state at entry and
% restored it via \aftergroup\ptj@frame@pop at each box close.
% \aftergroup inserts real assignment tokens right after the box --
% and \leaders\hbox{...}<glue> REQUIRES the glue to follow the box
% with nothing unexpandable in between. Every leader box (LaTeX TOC
% dot leaders, user \leaders/\xleaders, \cleaders) therefore died
% with "Leaders not followed by proper glue" -- reproduced for
% yoko AND tate, with or without CJK in the leader box, with
% article+pdftexja-jfmglue.sty alone (no output routine involved). The tate TOC
% pass-2 defect was exactly this, not a rotation problem. Candidate
% measured unusable: the quantity is not readable in restricted
% horizontal mode (\raise\hbox{}, math), so box entries there fail.
% The present design (neutralize at entry + boxbdd at reads +
% glyphmark to tell our own glyph boxes from user boxes) has the
% same observable boundary semantics and leaves leader scans clean.
%     glyphmark: 1 after each observed CJK glyph, 0 at each
%     (non-backend) box entry. The backend's own glyph boxes are
%     nest-guarded, so the mark distinguishes "\lastnodetype 13 is
%     our charbox" (mark=1, ordinary pair lookup) from "a user box
%     has just closed" (mark=0, boxbdd). Without the mark every tate
%     glyph (a rotated charbox, 13) would read as a box boundary.
\newcount\ptj@nest % backend-internal box guard (see glyph@tate/math)
\newcount\ptj@glyphmark \global\ptj@glyphmark=0
% Group-local direction enum, 0=yoko 1=tate, switched by the box
% factory / theindex pages; the glyph layer reads it via
% \ptj@ifydir/@iftdir. The MAIN document direction seeds it
% from \ifptj@tate at begin document (pdftexja-core.sty).
\newcount\ptj@dir \global\ptj@dir=0
% neutral box-start state (boxbdd semantics: 90, no pending penalty).
% Keep inhibit (see above); resync lastzw so the first interior
% boundary blends against the live glyph size.
\def\ptj@box@neutralize{%
  \global\ptj@lastclass=90
  \global\ptj@lastnodechar=-1
  \global\ptj@pend=0
  \global\ptj@lastzw=\ptj@zwreg
  \global\ptj@glyphmark=0
}
% boxbdd re-neutralization at a read whose previous node is a closed
% USER box (\lastnodetype 13/14 and glyphmark=0): the pair is
% evaluated against the boundary pseudo class 90, not against the
% stale interior state -- pTeX box semantics (boxes isolate JFM
% state). Keep inhibit; resync lastzw.
\def\ptj@boxbdd{%
  \ifnum\ptj@glyphmark=0
    \ifnum\lastnodetype=13
      \ptj@boxbdd@
    \else
      \ifnum\lastnodetype=14
        \expandafter\ptj@boxbdd@
      \fi
    \fi
  \fi}
\def\ptj@boxbdd@{%
  \global\ptj@lastclass=90
  \global\ptj@lastnodechar=-1
  \global\ptj@pend=0
  \global\ptj@lastzw=\ptj@zwreg
}
% class-side reader variant (\ptjupdatelastnodechar):
% when the reader directly follows a closed user box, the observed
% lastnodechar must read as "no preceding char" (-1), matching the
% boxbdd semantics of the glyph-side reader above.
\def\ptj@boxbddlastchar{%
  \ifnum\ptj@glyphmark=0
    \ifnum\lastnodetype=13
      \global\ptj@lastnodechar=-1
    \else
      \ifnum\lastnodetype=14
        \global\ptj@lastnodechar=-1
      \fi
    \fi
  \fi}
% neutral paragraph start (everypar / para/begin / math entry): the
% boundary class, pending penalty, the last-node scalar and the
% inhibit flag reset; lastzw re-syncs to the CURRENT zw so the first
% boundary of the paragraph blends against the live glyph size (the
% init 1pt must not leak into the first pair's scaling -- the nibu
% 90->1 (-0.5zw) glue came out +1.75pt exactly that way).
\def\ptj@state@neutral{%
  \global\ptj@lastclass=90
  \global\ptj@lastnodechar=-1
  \global\ptj@pend=0
  \global\ptj@inhibit=0
  \global\ptj@lastzw=\ptj@zwreg
  \global\ptj@glyphmark=0
}
% entry hook for everyhbox/everyvbox. NO \aftergroup (see the
% semantic-frames comment). Guard: no-op inside backend-internal
% construction.
\def\ptj@box@enter{%
  \ifnum\ptj@nest=0
    \ptj@box@neutralize
  \fi
}
%. -------------------------------- per-character parameters
% Kinsoku and jaxspmode are per CHARACTER (as in LuaTeX-ja):
%   \ptj@kpre@<cp>  = prebreakpenalty  (char must not start a line)
%   \ptj@kpost@<cp> = postbreakpenalty (char must not end a line)
%   \ptj@jxsp@<cp>  = jaxspmode, LuaTeX-ja numbering:
%                     0 inhibit, 1 preonly, 2 postonly, 3 allow (default)
% The tables are global (like LuaTeX-ja's kinsoku tables). Defaults come
% from pdftexja-kinsoku.tex (generated from LuaTeX-ja's ltj-kinsoku.tex).
\def\ptj@defkinsoku#1#2#3{% {pre|post|jxsp}{<cp>}{<value>}
  \expandafter\xdef\csname ptj@k#1@#2\endcsname{#3}}
\def\ptj@jxsp#1{% expandable: jaxspmode of codepoint #1
  \ifcsname ptj@kjxsp@#1\endcsname\csname ptj@kjxsp@#1\endcsname\else 3\fi}
% \ptj@cpof{<char spec>}: expandable decimal codepoint of
%   <utf-8 char>, `<utf-8 char>, `<ascii char>, <number> ("3001, 12289,
%   \count register, \numexpr...)
\def\ptj@cpof#1{\the\numexpr\ptj@cpof@a#1\ptj@cpof@end\relax}
\def\ptj@cpof@a#1{%
  \ifcat\relax\noexpand#1\expandafter\ptj@cpof@num
  \else\expandafter\ptj@cpof@b\fi#1}
\def\ptj@cpof@b#1{%
  \ifx`#1\expandafter\ptj@cpof@bq
  \else\ifnum`#1>127 \expandafter\expandafter\expandafter\ptj@cpof@utf
  \else\expandafter\expandafter\expandafter\ptj@cpof@num
  \fi\fi#1}
\def\ptj@cpof@bq`{\ptj@cpof@utf}
\def\ptj@cpof@num#1\ptj@cpof@end{#1}
\def\ptj@cpof@utf#1{%
  \csname ptj@cpof@n\ifnum`#1<"80 1\else\ifnum`#1<"E0 2\else
    \ifnum`#1<"F0 3\else 4\fi\fi\fi\endcsname#1}
\expandafter\def\csname ptj@cpof@n1\endcsname#1#2\ptj@cpof@end{`#1}
\expandafter\def\csname ptj@cpof@n2\endcsname#1#2#3\ptj@cpof@end{%
  (`#1-"C0)*64+`#2-"80}
\expandafter\def\csname ptj@cpof@n3\endcsname#1#2#3#4\ptj@cpof@end{%
  (`#1-"E0)*4096+(`#2-"80)*64+`#3-"80}
\expandafter\def\csname ptj@cpof@n4\endcsname#1#2#3#4#5\ptj@cpof@end{%
  (`#1-"F0)*262144+(`#2-"80)*4096+(`#3-"80)*64+`#4-"80}
% value parsers for \ptjsetparameter
\def\ptj@param@charval#1#2{% #1=pre|post|jxsp, #2=<char>,<value>
  \ptj@param@charval@a{#1}#2\@nil}
\def\ptj@param@charval@a#1#2,#3\@nil{%
  \edef\ptj@tmpcp{\ptj@cpof{#2}}%
  \ifnum\pdfstrcmp{#1}{jxsp}=0
    \ptj@param@jxspval{#3}%
  \else
    \edef\ptj@tmpval{\number\numexpr#3\relax}%
  \fi
  \ptj@defkinsoku{#1}{\ptj@tmpcp}{\ptj@tmpval}}
\def\ptj@param@jxspval#1{%
  \edef\ptj@tmpval{\zap@space#1 \@empty}%
  \ifnum\pdfstrcmp{\ptj@tmpval}{inhibit}=0 \def\ptj@tmpval{0}\else
  \ifnum\pdfstrcmp{\ptj@tmpval}{preonly}=0 \def\ptj@tmpval{1}\else
  \ifnum\pdfstrcmp{\ptj@tmpval}{postonly}=0 \def\ptj@tmpval{2}\else
  \ifnum\pdfstrcmp{\ptj@tmpval}{allow}=0 \def\ptj@tmpval{3}\else
    \edef\ptj@tmpval{\number\numexpr\ptj@tmpval\relax}%
  \fi\fi\fi\fi}
%. -------------------------------------- kanjiskip / xkanjiskip
% The (x)kanjiskip are glue SPECS evaluated at every use (so zw-relative
% values follow the current size). Default: the JFM's own values
% (\ptj@jfm@kanjiskip / \ptj@jfm@xkanjiskip, in zw), like LuaTeX-ja with
% kanjiskip = \maxdimen.
\def\ptj@jfmskip#1#2#3{#1\ptj@zwreg plus #2\ptj@zwreg minus #3\ptj@zwreg}
\def\ptj@kanjiskip{\expandafter\ptj@jfmskip\ptj@jfm@kanjiskip}
\def\ptj@xkanjiskip{\expandafter\ptj@jfmskip\ptj@jfm@xkanjiskip}
%. ------------------------------------------------- \ptjsetparameter
% \ptjsetparameter{<key>=<value>,...}
%   kanjiskip=<glue>, xkanjiskip=<glue>      (local; live specs)
%   prebreakpenalty={<char>,<int>}, postbreakpenalty={<char>,<int>}
%   jaxspmode={<char>,<inhibit|preonly|postonly|allow|0..3>}  (global)
%   scale=<real>                              (zw = \f@size * scale)
% <char> is a UTF-8 character, `<char> or a code point number.
\DeclareKeys[pdftexja/param]{
  kanjiskip.code = \def\ptj@kanjiskip{#1},
  xkanjiskip.code = \def\ptj@xkanjiskip{#1},
  prebreakpenalty.code = \ptj@param@charval{pre}{#1},
  postbreakpenalty.code = \ptj@param@charval{post}{#1},
  jaxspmode.code = \ptj@param@charval{jxsp}{#1},
  scale.code = \edef\ptj@scale{#1},
}
\protected\def\ptjsetparameter#1{\SetKeys[pdftexja/param]{#1}}
% \ptjgetparameter{<key>}[{<char>}] (expandable):
%   prebreakpenalty/postbreakpenalty/jaxspmode {<char>} -> integer
%   kanjiskip / xkanjiskip -> the glue spec tokens
\def\ptjgetparameter#1{\csname ptj@get@#1\endcsname}
\def\ptj@get@prebreakpenalty#1{\ptj@get@kval{pre}{\ptj@cpof{#1}}}
\def\ptj@get@postbreakpenalty#1{\ptj@get@kval{post}{\ptj@cpof{#1}}}
\def\ptj@get@kval#1#2{%
  \ifcsname ptj@k#1@#2\endcsname\csname ptj@k#1@#2\endcsname\else 0\fi}
\def\ptj@get@jaxspmode#1{\expandafter\ptj@jxsp\expandafter{\the\numexpr\ptj@cpof{#1}}}
\def\ptj@get@kanjiskip{\ptj@kanjiskip}
\def\ptj@get@xkanjiskip{\ptj@xkanjiskip}
% the default kinsoku / jaxspmode table
\ifptj@kinsoku
  \InputIfFileExists{pdftexja-kinsoku.tex}{}{%
    \PackageWarningNoLine{pdftexja}{pdftexja-kinsoku.tex not found;
      no default kinsoku}}%
\fi
%. --------------------------- unified boundary emitter
% One boundary = ONE emitter. It produces, between the previous glyph
% and the next glyph:
%   [end_adjust candidate series]   (only when the PREVIOUS class has
%      end_adjust data): for ascending candidates e_1..e_m (zw, kept
%      ASCENDING as the .def emits them, 0 included):
%        kern(e_1) penalty(p)
%        [kern(e_{i+1}-e_i) penalty(p)] ...
%        kern(-e_m) penalty(10000)
%      then the pair glue follows. A break at candidate i leaves the
%      cumulative kern (= e_i) on the line (PROTRUSION); a break at the
%      glue leaves net 0 (the series sums to zero) = the e=0 candidate.
%      The 0 candidate stays in the list; the glue itself remains the
%      final legal break (its break is the net-0/ordinary one) so no
%      duplicate break is created beyond that.
%      (Reference: ltj-adjust.lua:366-393 insert_lineend_kern,
%      extended mode; verified empirically that pdfTeX keeps the
%      preceding kerns on the broken line and drops the rest.)
%   [pair glue] nat/str/shr scaled by the blended zw + the kanjiskip
%      companion glue (separate node, from the CURRENT
%      \ptj@kanjiskip/\ptj@xkanjiskip per the pair's knat/kstr/kshr
%      flags).
% The single boundary penalty p = post(prev) + pre(next) is applied at
% every candidate (each candidate is a legal break). kinsoku-forbidden
% boundaries (p>=10000) emit the series too -- the candidates simply
% cannot be chosen -- and the pair glue keeps its stretch/shrink (no
% kern-ification; the old kernmode hack is gone).
\def\ptj@emitpair{%
  \ifnum\ptj@inhibit=1
    \global\ptj@inhibit=0
  \else
    \ptj@emitpair@xspc
  \fi
}
% xspc suppression:
%  latin -> CJK blocked when curclass is postonly (4)
%  CJK -> latin blocked when lastclass is preonly (9,10,11,15,16)
% jaxspmode (LuaTeX-ja numbering 0 inhibit/1 preonly/2 postonly/3 allow):
%  latin -> CJK needs the next char's mode to allow "before" (1 or 3)
%  CJK -> latin needs the previous char's mode to allow "after" (2 or 3)
\def\ptj@emitpair@xspc{%
  \ifnum\ptj@lastclass=27
    \ifodd\ptj@jxsp{\number\ptj@curcp}\relax
      \ptj@emitpair@main
    \else
      % latin -> postonly/inhibit char: no glue
    \fi
  \else
    \ifnum\ptj@curclass=27
      \ifnum\ptj@jxsp{\number\ptj@lastnodechar}>1
        \ptj@emitpair@main
      \else
        % preonly/inhibit char -> latin: no glue
      \fi
    \else
      \ptj@emitpair@main
    \fi
  \fi
}
% main: evaluate the pair (9 fields, live fallback) then emit.
% jidorimode (字取り/空き組み) replaces the pair glue as before.
\def\ptj@emitpair@main{%
  \ifnum\ptj@lastclass=93
    % explicit space between: no boundary glue (ltj: glue pseudo-char)
  \else
    \ifnum\ptj@jidorimode>0
      \ifnum\ptj@lastclass=90
        % 行頭相当（box先頭）: グルーなし
      \else
        \ifnum\ptj@jidorimode=2
          \hskip 0pt plus 1fil\relax
        \else
          \hskip\ptj@akiskip
        \fi
      \fi
    \else
      \ptj@evalpair
      \ptj@emitboundary
    \fi
  \fi
}
% \ptjjidoribox{<width>}{<text>}: 字取り -- <text> set to <width>, all
% inter-character boundaries become 0pt plus 1fil (the LuaTeX-ja
% "all stretch goes between the characters" semantics).
% \ptjakigumibox{<skip>}{<text>}: 空き組み -- every inter-character
% boundary becomes <skip>. The box start is a boundary (no leading glue).
% <width>/<skip> may use the pTeX units zw, zh, Q, H (\ptjconvertunits).
\long\def\ptjjidoribox#1#2{%
  \begingroup
    \def\ptj@tmpw{#1}\ptjconvertunits\ptj@tmpw
    \ptj@jidorimode=2\relax
    \hbox to \dimexpr\ptj@tmpw\relax{#2\hskip 0pt minus 1fil\relax}%
  \endgroup}
\long\def\ptjakigumibox#1#2{%
  \begingroup
    \def\ptj@tmpw{#1}\ptjconvertunits\ptj@tmpw
    \ptj@akiskip=\glueexpr\ptj@tmpw\relax
    \ptj@jidorimode=1\relax
    \hbox{#2}%
  \endgroup}
% ---- pair evaluation (shared by the emitter, calc@jfmglue and the
% strict paragraph module) --
% Sets: \ptj@nat/@str/@shr (pair glue, sp), \ptj@knat/@kstr/
% @kshr (kanjiskip companion components, sp; 0 when no companion),
% \ptj@pairspri/@pairshpri (tier priorities for the strict
% paragraph module), and the blended zw pair used for the scaling.
% Lookup key:
% \ptj@jfm@pair@<lastclass>@<curclass>.
%  - defined pair: all 9 fields evaluated. nat/str/shr are in zw units;
%    with different zw on the two sides (mixed font sizes) each
%    component x is realized as the ltj average blend
%      b_val = (1-r_b) x zw_prev + r_b x zw_cur
%      a_val = (1-r_a) x zw_prev + r_a x zw_cur
%      val   = (b_val + a_val)/2       (diffmet_rule = two_paverage,
%                                      ltj-jfmglue.lua:157,812-824)
%    where r_b/r_a are the pair's ratio (field 4; 0.5 default).
%  - undefined pair: fallback = the CURRENT \ptj@kanjiskip (JA-JA) /
%    \ptj@xkanjiskip (latin side) glue spec, parsed live (no fixed
%    constants). The companion is the full (x)kanjiskip glue in this
%    case (ltj: `if not g then g = get_(x)kanjiskip').
\newcount\ptj@jidorimode \global\ptj@jidorimode=0
\newskip\ptj@akiskip
\newdimen\ptj@parratio
\def\ptj@evalpair{%
  \edef\ptj@pairname{%
    ptj@jfm@pair@\number\ptj@lastclass
    @\number\ptj@curclass}%
  \expandafter\ifx\csname\ptj@pairname\endcsname\relax
    \ptj@evalpair@fallback
  \else
    \global\ptj@zw@prev=\ptj@lastzw
    \global\ptj@zw@cur=\ptj@zwreg
    \global\ptj@fbmode=0
    \csname\ptj@pairname\endcsname
    \global\ptj@lastzw=\ptj@zw@cur
  \fi
}
% \ptj@lastzw: zw in effect when the PREVIOUS glyph was placed
% (font-size changes between glyphs change \ptj@zwreg AFTER the glyph;
% record it at each glyph observation -- \ptj@pre does this).
\newdimen\ptj@lastzw \global\ptj@lastzw=10pt
% live fallback: the CURRENT \ptj@kanjiskip / \ptj@xkanjiskip glue
% SPEC (verbatim, orders preserved -- no fixed constants). Since the
% fallback glue IS the full skip, it is emitted verbatim via
% \ptj@fbmode: emitglue then does `\hskip\ptj@fbskip'.
% (Decomposing `\the<skip>' into a dimen would leak the ` plus...'
% tokens into the stream and lose fil orders; the verbatim skip keeps
% both exact.)
\newskip\ptj@fbskip
\newcount\ptj@fbmode % 1 = fallback: emit \ptj@fbskip verbatim
\def\ptj@evalpair@fallback{%
  \global\ptj@zw@prev=\ptj@lastzw
  \global\ptj@zw@cur=\ptj@zwreg
  \global\ptj@fbmode=1
  \ifnum\ptj@lastclass=27 \ptj@fbskip=\ptj@xkanjiskip
  \else\ifnum\ptj@curclass=27 \ptj@fbskip=\ptj@xkanjiskip
  \else \ptj@fbskip=\ptj@kanjiskip
  \fi\fi
  \global\ptj@lastzw=\ptj@zw@cur
  % fallback = the full skip: it IS the pair glue; no separate companion
  \global\ptj@knat=0pt
  \global\ptj@kstr=0pt
  \global\ptj@kshr=0pt
  \global\ptj@pairspri=0
  \global\ptj@pairshpri=0
}
% pairfields: evaluate ALL NINE fields. #1..#3 nat/str/
% shr (zw), #4 ratio, #5 spri, #6 shpri, #7 knat, #8 kstr, #9 kshr.
% The zw scaling uses the two_paverage blend of the prev/cur zw; with
\newcount\ptj@pairkernflag % 1 = the defined pair is a JFM kern
\def\ptj@pairkern#1#2{%
  \global\ptj@pairkernflag=1
  \ptj@parratio=#2pt\relax
  \ptj@blendzw{#1}\ptj@nat
  \ptj@str=0pt \ptj@shr=0pt
  \global\ptj@pairspri=0 \global\ptj@pairshpri=0
  \global\ptj@knat=0pt \global\ptj@kstr=0pt \global\ptj@kshr=0pt}
\def\ptj@pairfields#1#2#3#4#5#6#7#8#9{%
  \global\ptj@pairkernflag=0
  \ptj@parratio=#4pt\relax % ratio as a pt-dimen: 0.500000 -> 0.5pt
  \ptj@blendzw{#1}\ptj@nat
  \ptj@blendzw{#2}\ptj@str
  \ptj@blendzw{#3}\ptj@shr
  \global\ptj@pairspri=#5\relax
  \global\ptj@pairshpri=#6\relax
  % kanjiskip companion: a SEPARATE glue node derived from the CURRENT
  % \ptj@kanjiskip (its natural/stretch/shrink), gated by the pair's
  % knat/kstr/kshr flags (ltj get_kanjiskip_low(flag=true,...)):
  %   knat=1 -> companion natural = kanjiskip natural, etc.
  % Natural extraction: `\the<skip>' expands to the FULL glue spec
  % ("0.0pt plus 2.5pt...") and a dimen assignment would leak the
  % ` plus...' tokens into the stream -- so the natural is split off
  % via the space-delimited \ptj@ksnatsplit (see below; glue
  % naturals are always finite; stretch/shrink are read directly via
  % \gluestretch/\glueshrink).
  \ptj@fbskip=\ptj@kanjiskip\relax
  \ifnum#7=1
    \edef\ptj@ksnattext{\the\ptj@fbskip}%
    \edef\ptj@ksnat{\expandafter\ptj@ksnatsplit\ptj@ksnattext\relax}%
    \global\ptj@knat=\ptj@ksnat\relax
  \else \global\ptj@knat=0pt \fi
  \ifnum#8=1 \global\ptj@kstr=\gluestretch\ptj@fbskip
  \else \global\ptj@kstr=0pt \fi
  \ifnum#9=1 \global\ptj@kshr=\glueshrink\ptj@fbskip
  \else \global\ptj@kshr=0pt \fi
}
% Kanjiskip-natural extraction: `\the<skip>' is "3.0pt plus 2.5pt..."
% with catcode-12 `pt' -- a delimited split on file-text `pt' can
% never match (that catcode mismatch was the "extra }" bug). Split on
% the first SPACE instead (space tokens keep catcode 10 through
% \edef): "0.0pt plus 2.5pt..." -> "0.0pt" (glue naturals are always
% finite; fil orders live only in the plus/minus parts, which are
% read separately via \gluestretch/\glueshrink).
\def\ptj@ksnatsplit#1 #2\relax{#1}
% blendzw{<zw-number>}{<target dimen>}: target = x * blended zw with
%   ltj-jfmglue.lua:812-857; b == a here because both sides share the
%   single JFM and its ratio, so the average halves b).
% \ptj@parratio holds r as a pt-dimen (0.500000 -> 0.5pt).
% sp^2 products overflow \dimexpr for glyph-sized inputs, so the blend
% is assembled with \advance: b = zw_prev + r*(zw_cur - zw_prev)
% (the delta is at most one glyph size, so the product stays small).
\def\ptj@blendzw#1#2{%
  \ptj@tmpa=\ptj@zw@cur
  \advance\ptj@tmpa-\ptj@zw@prev
  % dimen*dimen = sp^2; /65536 (plain integer, NO unit keyword --
  % `\dimexpr../65536pt' leaks the `pt' tokens) gives sp:
  %   r (pt-dimen) * delta / 1pt = r*delta
  \ptj@tmpa=\dimexpr\ptj@parratio*\ptj@tmpa/65536\relax
  \advance\ptj@tmpa\ptj@zw@prev
  % tmpa = b (blended zw); result = x * b  (x = #1, a plain coefficient)
  #2=\dimexpr#1\ptj@tmpa\relax
}
% ---- the emission itself ---------------------------------------------
% p = post(prev) + pre(next) -- ONE penalty value for the whole boundary.
% NOTE: dedicated registers only -- this runs INSIDE the CJK decoder
% (\@tempcnta carries the codepoint there; clobbering it produced
% "Bad character code" and corrupted glyphs).
\newcount\ptj@bpen
\def\ptj@boundaryp{%
  \ptj@bpen=0
  % post(prev): only when the previous item is a CJK glyph
  \ifnum\ptj@lastclass=27 \else\ifnum\ptj@lastclass=90 \else
  \ifnum\ptj@lastclass=93 \else
    \ifcsname ptj@kpost@\number\ptj@lastnodechar\endcsname
      \ptj@bpen=\csname ptj@kpost@\number\ptj@lastnodechar\endcsname\relax
    \fi
  \fi\fi\fi
  % pre(next): only when the next item is a CJK glyph
  \ifnum\ptj@curclass=27 \else
    \ifcsname ptj@kpre@\number\ptj@curcp\endcsname
      \advance\ptj@bpen\csname ptj@kpre@\number\ptj@curcp\endcsname\relax
    \fi
  \fi
}
% end_adjust candidate walker state
\newbox\ptj@charbox
\newdimen\ptj@tmpa
\newdimen\ptj@eaval
\newdimen\ptj@eaprev
\def\ptj@emitboundary{%
  \ptj@boundaryp
  \expandafter\ifx\csname ptj@jfm@endadj@\number\ptj@lastclass\endcsname\relax
    % no end_adjust data: the plain boundary -- one penalty + glue
    \ifnum\ptj@bpen>0 \penalty\ptj@bpen \fi
    \ptj@emitglue
  \else
    % candidate series (ascending e_1..e_m; 0 kept in the list).
    % NOTE the #1 indirection: `\expandafter\ptj@eawalk\csname...'
    % would hand the ENDADJ MACRO TOKEN to eawalk (an undelimited
    % argument takes a control sequence as one token); the wrapper's
    % `\expandafter...#1' expands the macro first so the walker sees
    % the brace-group FIELDS one by one.
    \ptj@eaprev=0pt
    \expandafter\ptj@easeries
      \csname ptj@jfm@endadj@\number\ptj@lastclass\endcsname
  \fi
}
\def\ptj@easeries#1{\expandafter\ptj@eawalk#1\ptj@eaend}
% eawalk{<e_i>}: emit kern(e_i - e_{i-1}) [penalty(p) kern(...)] ...
% series layout (first candidate: kern(e_1) then penalty(p)):
%   kern(e_1) penalty(p) kern(e_2-e_1) penalty(p) ... kern(e_m-e_{m-1})
%   penalty(p) kern(-e_m) penalty(10000)  THEN the pair glue.
\def\ptj@eawalk#1{%
  \def\ptj@eafield{#1}%
  \ifx\ptj@eafield\ptj@eaendmark
    % finish: undo kern + close the series, THEN the pair glue
    % (the glue break after penalty(10000) is the net-0/e=0 legal
    % break; the series sums to zero so a glue break leaves e=0)
    \kern-\ptj@eaprev
    \penalty10000
    \ptj@emitglue
    \expandafter\@gobble
  \else
    \ptj@eaval=#1\ptj@zw@prev\relax
    \ifdim\ptj@eaprev=0pt
      \kern\ptj@eaval
    \else
      \kern\dimexpr\ptj@eaval-\ptj@eaprev\relax
    \fi
    \ifnum\ptj@bpen>0 \penalty\ptj@bpen \else \penalty0 \fi
    \ptj@eaprev=\ptj@eaval
    \expandafter\@firstofone
  \fi
  {\ptj@eawalk}%
}
\def\ptj@eaendmark{\ptj@eaend}
\def\ptj@eaend{\ptj@eaend}
% the pair glue + kanjiskip companion emission.
% Fallback (fbmode=1): the CURRENT (x)kanjiskip glue verbatim (orders
% preserved). Defined pair: nat/str/shr (finite, zw-scaled) + the
% kanjiskip companion as its own glue node when any component is
% nonzero (ltj real_insert(k)). All-zero pair glue emits nothing
% (keeps the node stream lean; the candidate series already ended
% with penalty(10000) so no break is lost).
\def\ptj@emitglue{%
  \ifnum\ptj@fbmode=1
    \hskip\ptj@fbskip
  \else\ifnum\ptj@pairkernflag=1
    \ifdim\ptj@nat=0pt \else\kern\ptj@nat\fi
  \else
    \ifdim\ptj@nat=0pt
      \ifdim\ptj@str=0pt
        \ifdim\ptj@shr=0pt
        \else \ptj@emitglue@do
        \fi
      \else \ptj@emitglue@do
      \fi
    \else \ptj@emitglue@do
    \fi
  \fi\fi
  \ifdim\ptj@knat=0pt
    \ifdim\ptj@kstr=0pt
      \ifdim\ptj@kshr=0pt
      \else \ptj@emitkcomp
      \fi
    \else \ptj@emitkcomp
    \fi
  \else \ptj@emitkcomp
  \fi
}
\def\ptj@emitglue@do{%
  \hskip\ptj@nat
  \ifdim\ptj@str>0pt plus\ptj@str\fi
  \ifdim\ptj@shr>0pt minus\ptj@shr\fi
}
\def\ptj@emitkcomp{%
  \hskip\ptj@knat
  \ifdim\ptj@kstr>0pt plus\ptj@kstr\fi
  \ifdim\ptj@kshr>0pt minus\ptj@kshr\fi
}

%. ------------------------------------------------ post-break scratch
% (kept for external probes/tests; the emitter now computes p on the
% fly via \ptj@boundaryp, and \ptj@setpost below only records
% the class of the glyph just placed for \lastnodechar maintenance)
\def\ptj@setpost{%
  \global\ptj@lastnodechar=\ptj@cp
}

%. ----------------------------- hanging (negative end_adjust path)
% ぶら下げ（hanging_punctuation, -b 変種）はクラス6/7の end_adjust
% 候補 {-0.5, 0, 0.5}（zw）の「負候補」として同じ候補列で表現される。
% 行末で break が負候補 e=-0.5zw を選ぶと行は 0.5zw 突き出す。
% したがって:
%   - 裸字形専用分岐 (hangglyph), 負 hangkern, \rpcode 設定,
%     \pdfprotrudechars 変更 — すべて撤去 (JFM幅付き字形boxが標準)
%   - microtype との二重調整: 本バックエンドは \rpcode を一切設定
%     しない（microtype 既定の欧文 protrusion には触れない。欧文以外
%     のslotへ protrusion を設定するのは microtype 自身の設定次第で
%     あり、ここでは干渉しない — コメントとしての明記のみ）。
%   - 通常段落の末尾（para/end）: 最終和文字クラスに負の最小
%     end_adjust があれば、その tail kern (e_min) を parfillskip の
%     前へ挿入する（短い最終行を無理に両端揃えしない）。
%     ltj insert_lineend_kern_tail (ltj-adjust.lua:397-411) 相当。
\newdimen\ptj@tailkern
\def\ptj@para@endhook{%
  % If the paragraph's last node is a box, the tail-kern read
  % must use boxbdd semantics (no stale interior end_adjust).
  \ptj@boxbdd
  % inside the paragraph, before \parfillskip is added: if the last
  % observed CJK class has a negative minimal end_adjust candidate,
  % insert its kern so the final short line keeps the protrusion.
  \expandafter\ifx\csname ptj@jfm@endadj@\number\ptj@lastclass\endcsname\relax
  \else
    \ptj@tailkern=0pt
    % the #1 wrapper expands the endadj macro first (the same
    % undelimited-argument rule as \ptj@easeries -- see there)
    \expandafter\ptj@tailseries
      \csname ptj@jfm@endadj@\number\ptj@lastclass\endcsname
    \ifdim\ptj@tailkern<0pt \kern\ptj@tailkern \fi
  \fi
}
\def\ptj@tailseries#1{\expandafter\ptj@tailwalk#1\ptj@eaend}
\def\ptj@tailwalk#1{%
  \def\ptj@eafield{#1}%
  \ifx\ptj@eafield\ptj@eaendmark
    \expandafter\@gobble
  \else
    \ptj@eaval=#1\ptj@zw@cur\relax
    \ifdim\ptj@eaval<\ptj@tailkern
      \ptj@tailkern=\ptj@eaval
    \fi
    \expandafter\@firstofone
  \fi
  {\ptj@tailwalk}%
}

%. ------------------------------------------------- codepoint -> class
% The hooks receive the DECIMAL codepoint; the .def dispatch is keyed
% by hex. Rather than converting per character at runtime, the whole
% dispatch is re-keyed to decimal names ONCE here at load time:
%   \ptj@dcls@<decimal>  = class number.
% The hex keys are enumerated from the per-class chars@<n> lists of
% the loaded .def (U+XXXX entries; AJ1-<gid> entries are pTeX/VF-only
% and have no codepoint -- skipped). The combo lists (comma groups)
% are parsed too: the trailing codepoint of each combo is recorded in
% \ptj@combomarks so the runtime treats it as an attaching mark
% (no pair glue, no state update).
\newcount\ptj@cnta
\newcount\ptj@cntb
\newcount\ptj@hexacc
% hex -> decimal: \ptj@hextodec{<hexdigits>} sets \ptj@hexacc
\def\ptj@hextodec#1{%
  \global\ptj@hexacc=0
  \ptj@hextodec@a#1\ptj@htx@end
}
\def\ptj@hextodec@a#1{%
  \def\ptj@hxt{#1}%
  \ifx\ptj@hxt\ptj@htx@end
  \else
    {\ptj@cnta=`#1\relax
     \ifnum\ptj@cnta>96 \advance\ptj@cnta-87 % a-f -> 10..15
     \else\ifnum\ptj@cnta>64 \advance\ptj@cnta-55 % A-F
     \else\advance\ptj@cnta-48 % 0-9
     \fi\fi
     \global\multiply\ptj@hexacc16
     \global\advance\ptj@hexacc\ptj@cnta}%
    \expandafter\ptj@hextodec@a
  \fi
}
\def\ptj@htx@end{\ptj@htx@end}%

% The class list comes from the LOADED .def
% (\ptj@jfm@classlist, emitted by make_pdftex_jfm.lua 2.0+). The
% hardcoded 25-class list is gone. An old .def without classlist is an
% explicit data-version error.
\expandafter\ifx\csname ptj@jfm@classlist\endcsname\relax
  \PackageError{pdftexja}{JFM data file lacks ptj@jfm@classlist}{%
    The loaded JFM data variant was generated by an old make_pdftex_jfm.lua\MessageBreak
    (pre-2.0, no classlist). Regenerate with `make pdftex-jfm'.\MessageBreak
    \@ehc}%
\fi
\edef\ptj@classlist{\csname ptj@jfm@classlist\endcsname}%
% Load-time re-key of the dispatch into decimal names, plus the combo
% trailing-mark table (plain TeX/LaTeX2e only: the parent backend's
% \RequirePackage{expl3} leaves the ambient \ExplSyntaxOn regime
% unreliable mid-class, so this file avoids expl3 runtime functions).
%   \ptj@dcls@<decimal>  = class number
%   \ptj@combo@<decimal> = 1  (attaching mark: no pair glue)
\def\ptj@loadentry#1#2{% <entry> <class>
  \def\ptj@loadentry@com##1,##2\ptj@htx@end{%
    \def\ptj@loadentry@a{##1}\def\ptj@loadentry@b{##2}}%
  \expandafter\ptj@loadentry@com#1,\ptj@htx@end
  \expandafter\ptj@ajtest\ptj@loadentry@a\@nil
  \ifnum\ptj@ajflag=1 %
    % AJ1-<gid> entries are pTeX/VF-only: no codepoint, skip
  \else
    \ifx\ptj@loadentry@b\@empty
      \expandafter\ptj@regsingle\ptj@loadentry@a
        \ptj@htx@end{#2}%
    \else
      \expandafter\ptj@regcombo\ptj@loadentry@b
        \ptj@htx@end
    \fi
  \fi
}
% #1 = hex digits (variable length), #2 = class (for regsingle)
% skip everything that is not a U+XXXX code point (AJ1-<gid> glyph ids
% and pseudo names such as alchar/parbdd)
\def\ptj@ajtest#1#2#3#4\@nil{%
  \global\ptj@ajflag=1
  \def\ptj@ajfirst{#1#2}%
  \def\ptj@ajmark{U+}%
  \ifx\ptj@ajfirst\ptj@ajmark
    \global\ptj@ajflag=0
  \fi
}%
\newcount\ptj@ajflag
\def\ptj@regsingle U+#1\ptj@htx@end#2{%
  \ptj@hextodec{#1}%
  \expandafter\xdef\csname ptj@dcls@\number\ptj@hexacc\endcsname{#2}%
}
\def\ptj@regcombo U+#1\ptj@htx@end{%
  \ptj@hextodec{#1}%
  \expandafter\xdef\csname ptj@combo@\number\ptj@hexacc\endcsname{1}%
}
\def\ptj@walklist#1#2{% <chars|combo> <class>
  \expandafter\ifx\csname ptj@jfm@#1@#2\endcsname\relax
  \else
    \edef\ptj@tempa{\csname ptj@jfm@#1@#2\endcsname\space}%
    \expandafter\ptj@walk@a\ptj@tempa\ptj@htx@end{#2}%
  \fi
}
\def\ptj@walk@a#1 #2\ptj@htx@end#3{%
  \def\ptj@item{#1}%
  \ifx\ptj@item\@empty
    % list exhausted (the trailing space we append)
  \else
    \ptj@loadentry{#1}{#3}%
    \ptj@walk@a#2 \ptj@htx@end{#3}%
  \fi
}
\def\ptj@loadclass#1{%
  \ptj@walklist{chars}{#1}%
  \ptj@walklist{combo}{#1}%
}
\@for\ptj@cls:=\ptj@classlist\do{%
  \expandafter\ptj@loadclass\expandafter{\ptj@cls}%
}

%. ------------------------------------------------------ runtime lookup
% \ptj@setclassof{<byte>}: CJK.sty の内部 \CJKsymbol は
% 「\CJK@plane（16進2桁のプレーン接頭）×256 + バイト値」形式で文字を渡す
% （例: 「= U+300C → plane "30", byte 12 → 0x30*256+12 = 12300）。
% Unicodeコードポイントを復元してからクラス表を引く。
% （undefined codepoint => class 0 = default CJK, as in the JFM.）
\def\ptj@setclassof#1{%
  \expandafter\ptj@hextodec\expandafter{\CJK@plane}
  \global\ptj@cp=\ptj@hexacc
  \multiply\ptj@cp256
  \advance\ptj@cp#1\relax
  \expandafter\ifx\csname ptj@combo@\number\ptj@cp\endcsname\relax
    \global\ptj@combo=0
    \global\ptj@curcp=\ptj@cp
    \expandafter\ifx\csname ptj@dcls@\number\ptj@cp\endcsname\relax
      \global\ptj@curclass=0
    \else
      \global\ptj@curclass=\csname ptj@dcls@\number\ptj@cp\endcsname\relax
    \fi
  \else
    % 接着記（combo後続コードポイント，例: U+309A）: 前クラス維持・無出力
    \global\ptj@combo=1
    \global\ptj@curclass=\ptj@lastclass
    \global\ptj@inhibit=1
  \fi
}%

%. ------------------------------------------------------------ the hooks
% \ptj@pre{<cp>}: before every CJK glyph (non-math). The unified
% boundary emitter handles [candidate series] [pair glue] with the
% single penalty p = post(prev)+pre(next) at every legal candidate.

%. ------------------------------------- shared pair evaluator
% \ptj@classofchar{<char-or-token>} -> \ptj@evalclass (count):
% the JFM class of the FIRST CJK glyph of the argument, implemented by
% typesetting the argument into a scratch box with the rules hooks
% active (\ptj@pre records the class of every observed glyph into
% \global\ptj@lastclass; the box's frame push/pop keeps the
% running state intact). No CJK glyph observed -> class 27 (alchar:
% latin run semantics). Undefined codepoints read class 0 (default
% CJK, as in the JFM).
\newcount\ptj@evalclass
\newbox\ptj@evalbox
\def\ptj@classofchar#1{%
  \global\ptj@evalclass=0
  \global\ptj@lastclass=90
  \global\ptj@inhibit=0
  \setbox\ptj@evalbox=\hbox{#1}%
  \ifnum\ptj@lastclass=90
    % no CJK glyph observed: latin run (alchar semantics)
    \global\ptj@evalclass=27
  \else
    \global\ptj@evalclass=\ptj@lastclass
  \fi
  \global\ptj@lastclass=90
}
% \ptj@classofcp{<decimal cp>}: the JFM class of a CODEPOINT,
% read straight from the loaded class tables -- no \char (pdfTeX \char
% only addresses 0..255; \tatechuyoko's before-glue query passes the
% observed \lastnodechar scalar, a full Unicode codepoint). Contract
% mirrors \ptj@setclassof: undefined codepoint -> class 0, combo
% continuation -> the PREVIOUS class (callers pass a leading real glyph,
% so the combo branch is not reachable here).
\def\ptj@classofcp#1{%
  \expandafter\ifx\csname ptj@combo@#1\endcsname\relax
    \expandafter\ifx\csname ptj@dcls@#1\endcsname\relax
      \global\ptj@evalclass=0
    \else
      \global\ptj@evalclass=\csname ptj@dcls@#1\endcsname\relax
    \fi
  \else
    \global\ptj@evalclass=0
  \fi}
% \ptj@evalpairglue{<class-a>}{<class-b>}: set the pair glue
% (natural only -- calc@jfmglue's contract is a skip natural) into
% \ptj@nat via the SAME evaluation the runtime boundary uses.
% Undefined pairs use the live fallback ((x)kanjiskip natural).
\def\ptj@evalpairglue#1#2{%
  % NO group: pairfields' dimen assignments are LOCAL to the current
  % level; inside a group they would be lost on close (verified: nat
  % reverted to 0). The caller (calc@jfmglue) wraps itself in \begingroup.
  \global\ptj@lastclass=#1\relax
  \global\ptj@curclass=#2\relax
  \global\ptj@fbmode=0
  \ptj@evalpair
  \ifnum\ptj@fbmode=1
    % fallback: the CURRENT (x)kanjiskip natural
    \ptj@fbskip=\ptj@kanjiskip
    \ifnum#1=27 \ptj@fbskip=\ptj@xkanjiskip
 \else\ifnum#2=27 \ptj@fbskip=\ptj@xkanjiskip
 \fi\fi
    \edef\ptj@ksnattext{\the\ptj@fbskip}%
    \edef\ptj@ksnat{\expandafter\ptj@ksnatsplit\ptj@ksnattext\relax}%
    \ptj@nat=\ptj@ksnat\relax
  \fi
}
%. ------------------------------------------------ public queries
% \ptjgetcharclass{<cp>}: expandable JFM class of a code point (0 for
% unlisted code points and combining marks).
\def\ptjgetcharclass#1{%
  \ifcsname ptj@combo@#1\endcsname 0\else
    \ifcsname ptj@dcls@#1\endcsname\csname ptj@dcls@#1\endcsname\else 0\fi
  \fi}
% \ptjgetjfmglue{<A>}{<B>}<skip>: natural width of the JFM glue (or the
% live (x)kanjiskip fallback) between the first CJK glyphs of <A> and
% <B>, at the current zw; <A>/<B> without a CJK glyph count as latin
% (class 27). \ptjgetjfmgluecp{<code point>}{<B>}<skip>: the same with
% <A> given as a code point (pdfTeX's \char only reaches 0..255).
% The running character state is reset to the paragraph boundary.
\def\ptjgetjfmglue#1#2#3{%
  \begingroup
    \ptj@classofchar{#1}%
    \edef\ptj@calc@cla{\the\ptj@evalclass}%
    \ptj@getjfmglue@b{#2}#3}
\def\ptjgetjfmgluecp#1#2#3{%
  \begingroup
    \ptj@classofcp{#1}%
    \edef\ptj@calc@cla{\the\ptj@evalclass}%
    \ptj@getjfmglue@b{#2}#3}
\def\ptj@getjfmglue@b#1#2{%
    \global\ptj@lastzw=\ptj@zwreg
    \ptj@classofchar{#1}%
    \edef\ptj@calc@clb{\the\ptj@evalclass}%
    \global\ptj@lastzw=\ptj@zwreg
    \ptj@evalpairglue{\ptj@calc@cla}{\ptj@calc@clb}%
    \edef\ptj@tmp{\noexpand#2=\the\ptj@nat\relax}%
  \expandafter\endgroup
  \ptj@tmp}
% \ptjsetlastchar{<code point>}: make the running state look as if the
% character <code point> had just been typeset (used after material that
% stands for a character, e.g. a zenkaku space built from glue): the next
% glyph evaluates its pair glue and kinsoku against it.
\def\ptjsetlastchar#1{%
  \global\ptj@lastnodechar=#1\relax
  \global\ptj@lastclass=\ptjgetcharclass{#1}\relax
  \global\ptj@lastzw=\ptj@zwreg
  \global\ptj@pend=0
  \global\ptj@glyphmark=1 }
% \ptjupdatelastnodechar: before reading \ptjlastnodechar right after a
% closed user box, apply the box boundary rule (no previous character).
\def\ptjupdatelastnodechar{\ptj@boxbddlastchar}
% Latin adjacency: when a CJK glyph is decoded at a
% paragraph/box head (lastclass=90) directly after a LATIN run
% (lastnodetype=0, a char node), the preceding latin text is treated
% as class 27 so the LA->JA boundary glue (xkanjiskip) fires.
% The check CANNOT live in \ptj@pre: inside the CJK decoder the
% font-switch whatsits make \lastnodetype read -1 there (verified by
% probe). It runs instead at the WRAPPED \CJK@X/XX/XXX/XXXX helper
% heads (\ptj@latadj), before the decoder emits anything.
% Discrimination (lastnodetype probes): latin run -> 0; indent
% box -> 1 (hlist); explicit space -> 11 (glue); kern -> 12; box ->
% 1; empty paragraph -> the indent box or nothing; ONLY type 0 is a
% char node = the latin run case. 空段落・indent・明示空白・glue・
% kern・直前boxは欧文と誤判定されない。
\def\ptj@latadj{%
  \ifnum\ptj@lastclass=90
    \ifnum\lastnodetype=0
      % direct latin adjacency at a paragraph/box head: class 27
      \global\ptj@lastclass=27
    \else
      % With every glyph boxed (boxglyphs), the preceding node is
      % OUR glyph box, not a char -- the glyphmark distinguishes it
      % from a user box (boxbdd keeps user boxes neutral).
      \ifnum\lastnodetype=1
        \ifnum\ptj@glyphmark=1
          \global\ptj@lastclass=27
        \fi
      \fi
    \fi
  \fi
}
\def\ptj@pre#1{%
  \ifmmode
    % CJK char inside math: no glue, no penalty, state untouched
    % (math counts as an alchar/latin boundary, set by the $-peek or
    % left over from the preceding latin run)
  \else
    % If the reader directly follows a closed user box, apply
    % boxbdd semantics -- the boundary pseudo class 90, not the stale
    % interior state (see \ptj@boxbdd).
    \ptj@boxbdd
    \ptj@setclassof{#1}%
    % Ruby adapter: while a ruby base pass is armed, record the
    % FIRST observed glyph's class/zw for the ruby's left boundary
    % (no-op unless \ptj@ruby@rec is armed; defined in
    % pdftexja-ruby.sty -- never re-run the base for this)
    \ptj@ruby@recordfirst
    \ifnum\ptj@inhibit=1
      \global\ptj@inhibit=0
    \else
      \ptj@beforeglyph
    \fi
    % the observed character becomes \ptjlastnodechar (also after an
    % \inhibitglue; a combining mark keeps its base character)
    \ifnum\ptj@combo=0 \ptj@setpost \fi
    \global\ptj@lastclass=\ptj@curclass
    % This glyph's node (bare char or our nest-guarded charbox)
    % is about to become the last node; mark it ours so a following
    % \lastnodetype=13/14 read at the next boundary is not mistaken
    % for a user box (see the semantic-frames comment).
    \global\ptj@glyphmark=1
  \fi
}
% \ptj@beforeglyph: the zero-glue \unskip (kinsoku residual --
% removes a FOREIGN zero-natural glue before a prebreak char; real,
% stretchy or negative user glue is never touched) then the boundary.
\def\ptj@beforeglyph{%
  \ifcsname ptj@kpre@\number\ptj@curcp\endcsname
    \ifnum\lastnodetype=11
      \ifdim\lastskip=0pt
        \unskip
      \fi
    \fi
  \fi
  \ptj@emitpair
}
% \ptj@peek: installed as \CJK@ignorespaces; runs after every CJK
% glyph. Detects a latin (or math-shift) follower and emits the
% CJK->LA boundary through the SAME unified emitter.
% この形は避ける: 「\ifmmode\else\futurelet..\fi」形は CJKutf8 の \CJK@XXX 末尾条件
% （\expandafter\CJK@ignorespaces\else..\fi\fi の残り \fi 群内）で展開され
% ると壊れる: \else スキップで消えたはずの \ptj@peek@a が古い
% \ptj@next で実行され，\CJK@XXX 末尾の \fi 群と突いて Extra \fi
% （再現条件: 直前に和文がある状態の $あ$ / 行列セル内和文）．
% 未来let本体を\elseスキップ域の外へ出し，数式時は引数ごと捨てる
% \@gobble イディオムに変える（引数形なのでスキップ域に未来letが残らない）．
\def\ptj@peek{%
  \ifmmode
    \expandafter\@gobble
  \else
    \expandafter\@firstofone
  \fi
  {\ptj@peek@do}%
}
% \ptj@peek@resume -- the aftergroup continuation of a peek
% deferred at a group end. It is the plain futurelet form: no
% correction is re-emitted at the group end itself (the follower's
% own hook emits the boundary), so no double boundary emission can
% happen. Note: when the closing group was a BOX whose
% last node was a CJK glyph, this resume still runs its \futurelet at
% the box edge -- the case \leaders\hbox{..<CJK>}<glue> remains
% unsupported (leader boxes with a bare CJK tail; the LaTeX TOC
% leader box ends in \null after the glyph, so the TOC path never
% defers). The universal leader breakage (every \leaders box, any
% content, via the frame-pop \aftergroup) is fixed by removing that
% \aftergroup (see the semantic-frames comment above).
\def\ptj@peek@resume{\ptj@peek}
% 非数式モードのときだけ実行される本体．
\def\ptj@peek@do{%
  \futurelet\ptj@next\ptj@peek@a
}
% CJK -> latin/math boundary: emit through the unified machinery with
% curclass=27 (the inhibit interlock is consumed here too --
% \inhibitglue between a CJK glyph and a latin run suppresses the
% xkanjiskip exactly once).
\def\ptj@peek@lat{%
  {\global\ptj@curclass=27
   \ptj@emitpair}%
  \global\ptj@lastclass=27
}

\def\ptj@peek@a{%
  \ifx\ptj@next\inhibitglue
    % \inhibitglue directly after a CJK glyph: consume it, execute it
    % (sets the interlock) and re-peek at the REAL follower, so a
    % latin follower goes through peek@lat -- which consumes the
    % interlock and suppresses the boundary glue exactly once (ltj
    % semantics; the 漢\inhibitglue abcあ case: the abc->あ boundary
    % then behaves normally instead of eating a second suppression).
    % The dispatch goes through a one-token body macro so the argument
    % scan of \ptj@eatig reaches the INPUT (the original token),
    % not this macro's own body (\else etc.).
    \expandafter\ptj@peek@ig
  \else
    \expandafter\ptj@peek@rest
  \fi
}
\def\ptj@peek@ig{\ptj@eatig}
% eat the lookahead'd \inhibitglue token, execute it, re-peek at the
% real follower (taking it as an argument CONSUMES the token: a plain
% token insertion looped forever on the never-consumed original)
\def\ptj@eatig#1{#1\ptj@peek}
\def\ptj@peek@rest{%
  \ifx\ptj@next\@sptoken
    % explicit space: neutral (ltj's glue pseudo-char: no boundary
    % glue across a user space)
    \global\ptj@lastclass=93
  \else
    \ifx\ptj@next\egroup
      % group end: resume the peek after the group.
      % The resume macro (not \ptj@peek itself) first checks
      % whether the group that closed was a BOX (\lastnodetype 13/14
      % and glyphmark=0): a box edge is boxbdd, no boundary glue is
      % emitted against the box, and -- critically -- the check makes
      % the aftergroup token expand to NOTHING there, so
      % \leaders\hbox{...}<glue> scans stay intact (this aftergroup
      % is what previously surfaced as \futurelet inside the leader
      % glue scan). Plain {..} groups contribute no node, so the
      % resumed peek proceeds there exactly as before.
      \aftergroup\ptj@peek@resume
    \else
      \ifx\ptj@next$%
        \ptj@peek@lat
      \else
        % tate では $ はアクティブ文字になる（pdftexja-core.sty の数式
        % キャプチャ入口）．アクティブ$トークンの意味は
        % \ptj@tate@dollar@cmp と一致するため，その \ifx で捕える．
        % 横組みでは \ptj@tate@dollar@cmp は未定義のままで，
        % この枝は常に偽（既存挙動と一致）．
        \ifx\ptj@next\ptj@tate@dollar@cmp
          \ptj@peek@lat
        \else
        \ifcat\noexpand\ptj@next a%
          \ptj@peek@lat
        \else
          \ifcat\noexpand\ptj@next 1%
            \ptj@peek@lat
          \else
            % CJK bytes, control sequences, groups: leave the state;
            % the follower's own hook handles the pair
          \fi
        \fi
        \fi
      \fi
    \fi
  \fi
}
\def\ptj@eatig#1{#1\ptj@peek}
% (peek@cont removed -- its role was "futurelet-only
% continuation" to avoid the double hangkern, but hangkern itself is
% gone with the old rpcode machinery; the aftergroup peek at egroup is
% already the plain futurelet form. No caller remains.)

% \ptj@glyph{<cp>}: the glyph typesetter called from the inner
% \CJKsymbol hook (all UTF-8 routes funnel here under noCJKpunct).
% JFM class metrics say the glyph advance may be < 1zw (class@<n>
% {w}{h}{d}{align}: e.g. 約物 class 1/2/6/7 = 0.5zw, 半角 class 192
% = 0.333zw). The font glyph is always full-width (IPAex), so the
% JFM width is realized by typesetting the glyph in an \hbox of the
% JFM width and positioning it per the class align field
% (ltj/luatexja-jfm.lua: the "align" table shifts the glyph inside
% the char box):
%   left   = glyph at the LEFT edge of the box (overhangs right)
%   middle = glyph centered (overhangs both)
%   right  = glyph at the RIGHT edge of the box (overhangs left)
% w = 1zw (or no metrics: default CJK class) -> unchanged typesetting
% (no box, byte-identical node stream, marker-kern machinery safe).
% The JFM h/d stay font-natural: align placement is horizontal only
% (the box keeps the glyph's own height/depth, as in ltj where the
% vertical metrics are untouched). The IPAex glyph is always
% FULL-width (1zw) while the box is w<1zw, so the box is SHORTER than
% its content: the spacers must be \hss (negative shrink). \hfil
% (plus-only) cannot shrink and turns every narrowed punct into an
% overfull box.
\def\ptj@glyph#1{%
  \ifmmode
    % 数式内: \hboxに包んで出す．数式中の\charはバイト値を「ASCIIのmathcode」
    % で再解釈してしまう（あ=U+3042→サブフォントバイト0x42が欧文フォントの
    % 「B」と化ける）ため、\charがテキストモード扱いに戻る\hboxが必須．
    % C70フォント選択は\CJK@punctchar側の\usefont群が済ませているので
    % フォントはボックス内に引き継がれる．
    % \ptj@preは数式でクラス更新しないためJFM狭めボックス等も使わず，
    % 常に自然幅．状態には触れない．
    % backend-internal box: guard the frame machinery
    \global\advance\ptj@nest1
    \hbox{\ptj@orig@CJKsymbol{#1}}%
    \global\advance\ptj@nest-1
  \else
    \ifptj@tate
      \ptj@glyph@tate{#1}%
    \else
      \expandafter\ifx\csname ptj@jfm@class@\number\ptj@curclass\endcsname\relax
        \ptj@orig@CJKsymbol{#1}%
      \else
        \expandafter\ptj@placeglyph
          \csname ptj@jfm@class@\number\ptj@curclass\endcsname
          {#1}%
      \fi
    \fi
  \fi
}
%. --------------------------------------------------------- tate glyph
% 縦組みグリフ（プロファイル駆動）. 1 グリフ = 内側（水平段落）枠
% 組みの JFM クラス幅進行ボックス。グリフ選択はフォントプロファイル
% （pdftexja-fontprofile-*.def が供給、pdftexja-core.sty が読み込む）:
%   \ptj@vglyph@<HEX>{{sub}{adv}{vorg}{ink x0 y0 x1 y1}{shard}{slot}{uni}}
% sub=1 → 補助縦フォントの真縦字形（upright・回転なし）を slot 経由で
%   出力（advance は vmtx 由来）。
% sub=0 → 通常グリフを 90°（CCW）回転（内枠組；出荷の -90° で正立）。
% 進行幅 = JFM クラス幅（class@<n> の w）× 現在 \ptj@zwreg。固定 1zw は
% 使わない。高さ/深さ = JFM クラスの h/d × \ptj@zwreg（縦組みデータは
% 0.5/0.5）。ink/vorigin 補正は em 単位 × 現在の jareg で毎回計算
% （サイズ/書体/系列変更後もプロファイル×現zwで再計算される）。
% 旧 off@<class> 生 pt 表（10pt 代表字由来）は廃止。
\def\ptj@glyph@tate#1{%
  % \ptj@pre (called first by the CJKsymbol wrap) restores the
  % Unicode codepoint into \ptj@cp (the raw #1 here is just the
  % plane byte: `\CJK@plane*256+#1').  The profile keys are DECIMAL
  % codepoints.
  \expandafter\ifx\csname ptj@vglyph@\number\ptj@cp\endcsname\relax
    \ptj@glyph@tate@plain{#1}%
  \else
    \expandafter\ptj@vgparse
      \csname ptj@vglyph@\number\ptj@cp\endcsname
    \ifnum\ptj@vg@sub=1
      \ptj@glyph@tate@vert{#1}%
    \else
      \ptj@glyph@tate@rot{#1}%
    \fi
  \fi
}
% {{sub}{adv}{vorg}{{x0}{y0}{x1}{y1}}{shard}{slot}{uni}}
\def\ptj@vgparse#1{\expandafter\ptj@vgparse@a#1}
\def\ptj@vgparse@a#1#2#3#4#5#6#7{%
  \ptj@vg@sub=#1
  \def\ptj@vg@adv{#2}%
  \def\ptj@vg@vorg{#3}%
  \def\ptj@vg@ink{#4}%
  \def\ptj@vg@shard{#5}%
  \def\ptj@vg@slot{#6}%
  \def\ptj@vg@uni{#7}%
}
\newcount\ptj@vg@sub
% sub=0: rotate the normal glyph; place ink per the profile ink/vorg in em
% units against the JFM class cell.  The old fixed raise/shift pt table is
% replaced by per-glyph em data × current \ptj@zwreg.
% 挿入物文脈フラグ \ptj@insctx (=1 のとき): 挿入物(脚注等)の
% 内側では縦字形ボックスの ht/dp を JFM クラスの h/d×zw に正規化する。
% 本文では従来どおり rotatebox の自然寸法(ht=エム/dp=0)のまま — 本文側は
% 出荷回転の第一行カーンでこの規約を補正しているため(実測一致)。
% 挿入物側は native 縦組と同じ「エム箱が行基準線を挟んで中央」の
% 行内配置が全行(折返し行・複数段落脚注を含む)で得られる。
\newcount\ptj@insctx \global\ptj@insctx=0
\def\ptj@glyph@tate@rot#1{%
  \ptj@tate@classdims
  % backend-internal box: guard the frame machinery
  \global\advance\ptj@nest1
  \setbox\ptj@charbox=\hbox{%
    \rotatebox{90}{\ptj@orig@CJKsymbol{#1}}}%
  \global\advance\ptj@nest-1
  \wd\ptj@charbox=\ptj@cls@w\ptj@zwreg
  \ifnum\ptj@insctx=1
    \ht\ptj@charbox=\ptj@cls@h\ptj@zwreg
    \dp\ptj@charbox=\ptj@cls@d\ptj@zwreg
  \fi
  \box\ptj@charbox}
% sub=1: true vertical form from the auxiliary vertical font. The aux
% TFM is selected per family and the slot glyph is typeset inside the
% JFM-width cell.
% 脚注ブロック実測修正: 内枠（水平組み）は出荷の -90° 回転の
% 「回転前」空間であるため、その中身はすべて +90° 予備回転して
% 組む必要がある（rot path は \rotatebox{90} で行っている）。
% vert path は補助縦フォントの字形を素のまま描いていたため、
% 最終ページで全補助縦字形（（）。ー 等 sub=1 の全文字）が
% 90° 横倒しで刷られていた（実測: fn （ が横倒し、native と
% 形状不一致）。rot path と同じ回転を補助字形にもかけ、
% 回転後のボックス寸法は JFM クラスの w/h/d×zw で正規化する。
% さらに native vf と同一の置き型として、半角クラスの全角進行
% 字形を -(1zw-セル幅) だけ行頭側へずらして描く（uplatex 実測:
% （ セル [c,c+0.5em] に対し ink [c,c+1em]）。
\def\ptj@glyph@tate@vert#1{%
  \ptj@tate@classdims
  \global\advance\ptj@nest1
  \setbox\ptj@charbox=\hbox{%
    \kern\dimexpr\ptj@cls@w\ptj@zwreg-1\ptj@zwreg\relax
    \rotatebox{90}{%
      \ptj@auxfont
      \expandafter\char\ptj@vg@slot\relax}}%
  \global\advance\ptj@nest-1
  \ht\ptj@charbox=\ptj@cls@h\ptj@zwreg
  \dp\ptj@charbox=\ptj@cls@d\ptj@zwreg
  \wd\ptj@charbox=\ptj@cls@w\ptj@zwreg
  \box\ptj@charbox}
% no profile entry (e.g. yoko-only font in tate): rotate the plain glyph
% and keep the class width -- but ONLY when a profile exists at all;
% missing profile is a load-time error, not a silent fallback.
\def\ptj@glyph@tate@plain#1{%
  \ptj@glyph@tate@rot{#1}}
% class dims: w from class@<n>; h/d applied via the box's height/depth
\def\ptj@tate@classdims{%
  \expandafter\ifx\csname ptj@jfm@class@\number\ptj@curclass\endcsname\relax
    \def\ptj@cls@w{1}%
  \else
    % NOTE the #1 wrapper: `\expandafter\splitcls\csname...' hands the
    % CLASS MACRO TOKEN to splitcls as ONE undelimited argument (the
    % same rule as \ptj@easeries) -- the wrapper expands the
    % macro first so splitcls sees the five brace-group fields.
    \expandafter\ptj@tate@classdims@split
      \csname ptj@jfm@class@\number\ptj@curclass\endcsname
  \fi
}
\def\ptj@tate@classdims@split#1{\expandafter\ptj@splitcls#1}
% #1 = {{w}{h}{d}{align}{left}}, #2 = codepoint
% The JFM-width glyph box is THE standard for punct classes
% (no bare-glyph hanging branch; hanging protrusion is the negative
% end_adjust candidate of the SAME box glyph, applied at line end by
% the candidate series).
\def\ptj@placeglyph#1#2{%
  \expandafter\ptj@splitcls#1%
  \edef\ptj@tmpw{\ptj@cls@w\ptj@zwreg}%
  \ifdim\ptj@tmpw=1\ptj@zwreg
    \ifnum\ptj@boxglyphs=1
      % The strict paragraph environment boxes EVERY glyph
      % (1zw classes too) so its line interior contains only
      % boxes/glues/kerns/penalties -- the per-line distribution walk
      % can then address each item box. Nest-guarded like the punct
      % path (same frame-machinery reason).
      \global\advance\ptj@nest1
      \setbox\ptj@charbox=\hbox{\ptj@orig@CJKsymbol{#2}}%
      \hbox to \ptj@cls@w\ptj@zwreg{%
        \ptj@placealign
        \box\ptj@charbox
        \ptj@placealign@post}%
      \global\advance\ptj@nest-1
    \else
      \ptj@orig@CJKsymbol{#2}%
    \fi
  \else
    % backend-internal boxes: guard the frame machinery for BOTH the
    % measurement hbox and the outer JFM-width hbox (the everyhbox
    % hook must not push a frame here -- the glyph box is not a
    % semantic boundary and its push would neutralize lastclass
    % mid-run, wrecking the NEXT boundary's pair lookup).
    \global\advance\ptj@nest1
    \setbox\ptj@charbox=\hbox{\ptj@orig@CJKsymbol{#2}}%
    \hbox to \ptj@cls@w\ptj@zwreg{%
      \ptj@placealign
      \box\ptj@charbox
      \ptj@placealign@post}%
    \global\advance\ptj@nest-1
  \fi
}
% {<w>}{<h>}{<d>}{<align>}{<left>} -- brace-group delimited (the .def
% values are exactly one brace group each; digit-bearing control words
% are formed via \csname at the caller, never by \def here)
% h/d も保存する（縦字形ボックスの ht/dp を JFM クラス値で
% 正規化するため。cls@h/cls@d は {0.5} のような係数）。
\def\ptj@splitcls#1#2#3#4#5{%
  \def\ptj@cls@w{#1}%
  \def\ptj@cls@h{#2}%
  \def\ptj@cls@d{#3}%
  \def\ptj@cls@align{#4}%
}
\def\ptj@cls@h{0.5}%
\def\ptj@cls@d{0.5}%
% \ptjcharheight / \ptjchardepth: the logical character cell of the
% loaded JFM (class 0 height/depth x current zw) -- pTeX's \cht/\cdp.
% In the tate (shipout rotation) model the glyph boxes carry horizontal
% glyph metrics, so a class measuring \hbox{<kanji>} for its vertical
% furniture must use these values instead (0.5/0.5zw for vertical JFMs).
\def\ptj@clszero@split#1#2#3#4#5{%
  \def\ptj@clszero@h{#2}\def\ptj@clszero@d{#3}}
\expandafter\expandafter\expandafter\ptj@clszero@split
  \csname ptj@jfm@class@0\endcsname
\def\ptjcharheight{\dimexpr\ptj@clszero@h\ptj@zwreg\relax}
\def\ptjchardepth{\dimexpr\ptj@clszero@d\ptj@zwreg\relax}
% leading spacer: absent for left (glyph flush left), \hss otherwise
\def\ptj@placealign{%
  \def\ptj@tmpb{left}%
  \ifx\ptj@cls@align\ptj@tmpb
    \expandafter\@gobble
  \else
    \expandafter\@firstofone
  \fi
  {\hss}%
}
% trailing spacer: absent for right (glyph flush right), \hss otherwise
\def\ptj@placealign@post{%
  \def\ptj@tmpb{right}%
  \ifx\ptj@cls@align\ptj@tmpb
    \expandafter\@gobble
  \else
    \expandafter\@firstofone
  \fi
  {\hss}%
}

%. -------------------------------------------------------- installation
% Everything touching CJK/bxcjkjatype definitions must run AFTER those
% packages load (the parent loads this file first, bxcjkjatype after;
% bxcjkjatype itself redefines the inner \CJKsymbol, which would
% overwrite a load-time wrap). All of it is deferred to begin-document.
\newtoks\ptj@evhbox
\newtoks\ptj@evvbox
\def\ptj@evh@tmp{}%
% \ptj@evh@save<everyhbox|everyvbox>: capture the current tokens
% (via \edef -- a `\toks=\expandafter{...}' scan is invalid syntax)
% into the paired scratch register, then re-assign the primitive with
% our hook PREPENDED (user tokens still run exactly once, after ours).
\def\ptj@evh@save#1#2{%
  \edef\ptj@evh@tmp{\the#1}%
  \global#2\expandafter{\ptj@evh@tmp}%
}
\AtBeginDocument{%
  % (a) neutralize CJK's own inter-char glue: our pair glue resets
  %     \lastkern so their \CJK@testLastCJK/\CJK@testLastKern machinery
  %     cannot fire after our nodes; nulling the two glue macros makes
  %     the cases where we emit NOTHING (math, explicit space,
  %     inhibited boundaries) safe from double spacing too. Their
  %     net-zero marker kerns (\CJK@kern/\CJK@CJK) stay untouched.
  \renewcommand{\CJKglue}{}%
  \def\CJK@nobreakglue{\nobreak}%
  % (b) wrap the inner \CJKsymbol (robust-command internals; every
  %     UTF-8 route funnels here under noCJKpunct): class lookup,
  %     pair glue and kinsoku before the glyph
  \expandafter\let\expandafter\ptj@orig@CJKsymbol
    \csname CJKsymbol \endcsname
  \expandafter\def\csname CJKsymbol \endcsname#1{%
    \ptj@pre{#1}\ptj@glyph{#1}%
  }%
  % (c) post-glyph peek: the byte macros append \CJK@ignorespaces after
  %     each char (\CJKspace sets it to \@empty).
  %     F-peek fix: \CJK@ignorespaces runs INSIDE the helper's \ifx..\else
  %     branch (CJK@X/XX/XXX/XXXX, CJK.sty:975-1012), so a \futurelet there
  %     sees the helper's own trailing \fi, never the real follower --
  %     peek@lat (CJK->LA xkanjiskip) could never fire. Instead, restore
  %     \CJK@ignorespaces to its passive job (\@empty via \CJKspace) and
  %     wrap the four helpers so our peek runs AFTER the helper returns,
  %     i.e. after its \ifx has closed: \futurelet then sees the real
  %     next token.
  \global\let\CJK@ignorespaces\@empty
  \expandafter\let\csname ptj@orig@CJK@X\expandafter\endcsname
    \csname CJK@X\endcsname
  \expandafter\def\csname CJK@X\endcsname#1{%
    \ptj@latadj\csname ptj@orig@CJK@X\endcsname{#1}%
    \futurelet\ptj@next\ptj@peek@a}%
  \expandafter\let\csname ptj@orig@CJK@XX\expandafter\endcsname
    \csname CJK@XX\endcsname
  \expandafter\def\csname CJK@XX\endcsname#1#2{%
    \ptj@latadj\csname ptj@orig@CJK@XX\endcsname{#1}{#2}%
    \futurelet\ptj@next\ptj@peek@a}%
  \expandafter\let\csname ptj@orig@CJK@XXX\expandafter\endcsname
    \csname CJK@XXX\endcsname
  \expandafter\def\csname CJK@XXX\endcsname#1#2#3{%
    \ptj@latadj\csname ptj@orig@CJK@XXX\endcsname{#1}{#2}{#3}%
    \futurelet\ptj@next\ptj@peek@a}%
  \expandafter\let\csname ptj@orig@CJK@XXXX\expandafter\endcsname
    \csname CJK@XXXX\endcsname
  \expandafter\def\csname CJK@XXXX\endcsname#1#2#3#4{%
    \ptj@latadj\csname ptj@orig@CJK@XXXX\endcsname{#1}{#2}{#3}{#4}%
    \futurelet\ptj@next\ptj@peek@a}%
  % (d) semantic frames: PREPEND our state hook to the primitive
  %     everyhbox/everyvbox tokens (kernel's everymath-style freeze:
  %     capture the pre-existing user tokens into scratch token
  %     registers FIRST, then re-assign; the captured copy runs exactly
  %     once, after ours. Every box opens a group -> \aftergroup
  %     restores the parent state at close. Backend-internal boxes are
  %     guarded via \ptj@nest (see glyph/placeglyph/math).
  \ptj@evh@save\everyhbox\ptj@evhbox
  \global\everyhbox{\ptj@box@enter\the\ptj@evhbox}%
  \ptj@evh@save\everyvbox\ptj@evvbox
  \global\everyvbox{\ptj@box@enter\the\ptj@evvbox}%
  % (e) para/end hook: the short-final-line tail kern. \AddToHook{para/end}
  %     runs when the paragraph is being wrapped up -- BEFORE
  %     \parfillskip is contributed by TeX's paragraph builder? No:
  %     para/end runs when \par finishes the paragraph; material
  %     contributed there lands at the end of the paragraph content
  %     (before \parfillskip/\rightskip which TeX appends during
  %     line breaking). The tail kern is thus the last node before
  %     parfillskip -- the ltj insert_lineend_kern_tail position.
  \AddToHook{para/end}{\ptj@para@endhook}%
  % (f) document-start state: paragraph-boundary class, neutral scalars
  \ptj@state@neutral
}


% NB: classes may load pdftexja mid-class with @ as a letter;
% keep that state (no \makeatother here).
\endinput
