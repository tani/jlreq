%% jlreq-trimmarks-pdftex.def
%% pdfTeX (pdftexja) part of jlreq-trimmarks.sty: \input by
%% jlreq-trimmarks.sty when the engine is pdfTeX. The pLaTeX-compatible
%% tombow kernel (\iftombow, \maketombowbox, \@outputtombow, ...) is
%% provided by pdftexja; this file only adds what jlreq-trimmarks needs
%% on top of it (kept in a separate file because the d-branch contains
%% conditionals that pTeX would mis-nest when skipping).
  % \yoko/\tate/\adjustbaseline appear in jlreq-trimmarks' pTeX code
  % paths that pdfTeX also walks: \yoko is the identity here (the trim
  % mark area is horizontal), the rotated banners use the graphicx
  % substitute below instead of \tate.
  \ifx\yoko\@undefined\let\yoko\relax\fi
  \ifx\tate\@undefined
    \def\tate{\PackageError{jlreq-trimmarks}{the~rotated~banner~requires~pTeX~primitives;~under~pdfTeX~use~show=trimmarks}{\@ehc}}%
  \fi
  \ifx\adjustbaseline\@undefined\let\adjustbaseline\relax\fi
  \tombowdatefalse
  %% ---------------------------------------------------------------
  %% tate banner substitutes (graphicx rotation) -- tate-doc geometry.
  %% \jlreq@trimmarks@pdf@rotatebanner{<text>}: banner text rotated 90deg
  %% CW (\rotatebox{-90}) so it reads top-to-bottom, like the pTeX \tate
  %% banner.  Natural dims of the rotated run: wd = H+D (cross extent of
  %% the raw text box), ht = 0pt, dp = L (run length, ink descending from
  %% the reference point).  The wrapper captures the two extents into
  %% globally-assigned dimens -- cross and runlen -- for the slot
  %% placement tails in jlreq-trimmarks.sty, which apply the per-family
  %% stock corrections documented there (pTeX's tate-box ht/dp reads do
  %% not transfer 1:1: the rotated ink always extends right of and below
  %% the reference, while the pTeX box's ink-offset convention differs
  %% per slot family).  Corrections measured against uplatex+dvipdfmx
  %% ground truth: two bleed configurations, two page parities, run
  %% lengths 2..11 chars; agreement 0.03pt (glyph bearings cancel
  %% identically in both engines).
  \newdimen\jlreq@trimmarks@pdf@cross
  \newdimen\jlreq@trimmarks@pdf@runlen
  %% dedicated scratch: the slot placement tails use
  %% \jlreq@tempboxb for their own pre-shift wrapper, so the measuring
  %% box here must NOT share that register (a shared register let the
  %% slot's \dp read race with the move-out here and flipped the
  %% bottom-slot ink direction).
  \newbox\jlreq@trimmarks@pdf@rawbox
  \def\jlreq@trimmarks@pdf@rotatebanner#1{%
    \__jlreq_check_rotatebox:n { banner~(tate~slot) }%
    \setbox\jlreq@trimmarks@pdf@rawbox=\hbox{\rotatebox{-90}{#1}}%
    \global\jlreq@trimmarks@pdf@cross\wd\jlreq@trimmarks@pdf@rawbox
    \global\jlreq@trimmarks@pdf@runlen\dp\jlreq@trimmarks@pdf@rawbox
    \box\jlreq@trimmarks@pdf@rawbox
  }%
  %% Predefine every banner slot to \@empty.  An unassigned slot
  %% (e.g. the before@/after@ center aliases that only exist once the
  %% user sets them) is otherwise \let to \relax by \csname inside
  %% \jlreq@trimmarks@outputbanner and its (tate) body would run.
  \clist_map_variable:nNn { odd,even } \jlreq@trimmarks@pdf@par {
    \clist_map_variable:nNn {
      corner@top@left, tate@top@left, intate@top@left, yoko@top@left, inyoko@top@left,
      corner@top@right, tate@top@right, intate@top@right, yoko@top@right, inyoko@top@right,
      before@top@center, in@top@center, after@top@center,
      before@center@left, after@center@left, in@center@left,
      before@center@right, after@center@right, in@center@right,
      corner@bottom@left, tate@bottom@left, intate@bottom@left, yoko@bottom@left, inyoko@bottom@left,
      corner@bottom@right, tate@bottom@right, intate@bottom@right, yoko@bottom@right, inyoko@bottom@right,
      before@bottom@center, in@bottom@center, after@bottom@center
    } \jlreq@trimmarks@pdf@slot {
      \@namedef{jlreq@trimmarks@banner@\jlreq@trimmarks@pdf@par @\jlreq@trimmarks@pdf@slot}{}%
    }
  }
