%%
%% This is file 'jlreq-pdftex.sty'.
%% Experimental pdfTeX backend for the jlreq class (internal use).
%%
%% Loaded by jlreq.cls only when the engine is pdfTeX (engine letter `d').
%% NOT a public package: the loading contract, macro names and behaviour
%% may change at any time while the backend is under development.
%%
%% Milestone M2 scope (see docs/pdftex-compatibility.md):
%%   - glyph output via bxcjkjatype (CJKutf8, ipaex-type1 Type1 fonts)
%%   - always-on CJK state from class load time (metrics measurable)
%%   - \zw/\zh as size-tracking dimen-register macros; \Cht..\Chs declared
%%   - \mcfamily/\gtfamily/\mgfamily via CJKfamily; bold via CJKbold
%%   - horizontal (yoko) only; tate errors loudly
%%   - JFM pair glue / kinsoku / line-end adjustment: M4/M5 (loud errors)
%%

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{jlreq-pdftex}[2026/10/23 v0.2 jlreq pdfTeX backend (experimental, M2+M4)]
\RequirePackage{expl3}
\RequirePackage{jlreq-pdftex-rules}

%. ---------------------------------------------------------- glyph base
% P4 fontset: the class key pdftex_fontset (ipaex-type1|ipa|custom)
% selects the bxcjkjatype preset for the HORIZONTAL font axis:
%   ipaex-type1 -> ipaex-type1 (Type1 subfonts ipxm/ipxg; the default,
%                  unchanged behavior, embeds everywhere, ToUnicode ok)
%   ipa         -> ipa (TrueType uniweight preset: zhmetrics dynamic TFM
%                  chain unisong@Unicode@ etc.; dependency on
%                  zhmetrics/unisong*.tfm/Unicode.sfd is documented in
%                  docs/pdftex-dependencies.md and fails with the exact
%                  resource names if missing)
%   custom      -> no preset here: the user's profile supplies the
%                  vertical axis; the horizontal axis stays on the
%                  currently active CJK family (set up via
%                  \setminchofont/\setgothicfont by the user's profile
%                  or preamble)
% noCJKpunct : jlreq's own punctuation spacing comes from its JFM rules
%              (M4); CJKpunct's quanjiao kerning would double-apply.
% no `whole' : the CJK state is turned on here (always-on), not per env.
\def\jlreqpdf@fontopt{ipaex-type1}%
\ifx d\jlreq@engine
  \@ifundefined{jlreq@pdftex@fontset}{}{%
    \expandafter\ifx\csname jlreq@pdftex@fontset\endcsname\@empty\else
      \edef\jlreqpdf@fontopt{\csname jlreq@pdftex@fontset\endcsname}%
    \fi
  }%
\fi
% \pdfstrcmp compares the whole expansion byte-wise (a plain \ifx on a
% macro-to-char-tokens would compare only the FIRST token pair, so
% `custom' would lose its first letter and mis-branch).
\ifnum\pdfstrcmp\expandafter{\jlreqpdf@fontopt}{custom}=0 \relax
  \RequirePackage[noCJKpunct]{bxcjkjatype}%
\else
  \expandafter\RequirePackage\expandafter[\jlreqpdf@fontopt,noCJKpunct]{bxcjkjatype}%
\fi

%. --------------------------------------------------- always-on CJK state
% jlreq evaluates Japanese literals at class load time outside any env
% (char-class lists, \contentsname, heading labels, notes). The PoC's
% site-by-site env approach cannot cover that, so uncap CJK's
% encapsulation: make its \global/\active/\local prefixes really global
% and start the UTF8/ipxm state once. State then persists file-wide.
\makeatletter
\let\CJK@global\global
\let\CJK@active\global
\let\CJK@local\global
% P4: the CJK family follows the fontset's horizontal preset:
% ipaex-type1 -> ipxm/ipxg (Type1 planes, unchanged);
% ipa        -> mc/gt (the preset's uniweight TTF TFM chain);
% custom     -> mc/gt (the user's profile/preamble sets the real fonts).
\def\jlreqpdf@cjkfam{ipxm}%
\ifx\jlreqpdf@fontopt custom\relax
  \def\jlreqpdf@cjkfam{mc}%
\else
  \expandafter\ifx\jlreqpdf@fontopt ipa\relax
    \def\jlreqpdf@cjkfam{mc}%
  \fi
\fi
\CJK@envStart{}{UTF8}{\jlreqpdf@cjkfam}%
% \CJK@ignorespaces is NOT set up by envStart when entered directly
% (CJK.sty sets it in \CJKspace, normally called from the env form).
\CJKspace
% CJK's lazy \CJK@input (\makeatother..\makeatletter) may have flipped
% the @ catcode; re-issue before using @-named internals.
\makeatletter

%. --------------------------------------------------------------- units
% pdfTeX has no zw/zh units. Plain TeX's <factor><internal dimen>
% scan-dimen syntax (e.g. 2\baselineskip) still works, so define the
% units as macros expanding to a dimen register. jlreq keeps internal
% \jlreq@zw/\jlreq@zh via \let (= \zw below), so all existing
% `N\jlreq@zw' uses keep working; literal "zw" text inside option
% strings is rewritten by \jlreq@expand@speciallength (cls gate).
\newdimen\jlreq@jareg
\def\zw{\jlreq@jareg}%
\def\zh{\jlreq@jareg}%
% ipaex full-width glyphs are square: 1zh == 1zw == the JA design size.

% \Cht..\Chs are engine-provided under pTeX (plcore.ltx) and LuaTeX-ja
% (lltjfont.sty) but never declared by jlreq.cls; declare them here so
% the cls load-time measurement block works unmodified.
\newdimen\Cht
\newdimen\Cdp
\newdimen\Cwd
\newdimen\Cvs
\newdimen\Chs

%. -------------------------------------------------------------- fonts
% bxcjkjatype[ipaex-type1] already: \mcdefault->ipxm, \gtdefault->ipxg,
% \mgdefault->ipxg, \mcfamily/\gtfamily/\mgfamily as CJKfamily wrappers,
% rmfamily/sffamily/ttfamily hooked to CJKfamily selection. Latin NFSS
% stays a separate axis (no conflation). Nothing to redefine here.

% Bold: no bold IPAex Type1 face exists; bxcjkjatype defaults
% \CJKboldbyembolden ON (PDF 2 Tr), but \bfseries alone does not raise
% \CJK@bold@. Track the current NFSS series and switch CJK bold so
% \sffamily\gtfamily\bfseries headings embolden the kanji too.
\AddToHook{selectfont}{%
  \jlreq@pdftex@trackseries
}
\def\jlreq@pdftex@trackseries{%
  % カーネルの判定と同一（latex.ltxの\bfseries）: 系列名がbで始まる＝太字
  % （b, bx を捕捉．sb は捕捉しない——カーネルと同じ挙動）．
  \if b\expandafter\@car\f@series\@nil
    \expandafter\jlreq@pdftex@bold
  \else
    \expandafter\jlreq@pdftex@nobold
  \fi
}
\def\jlreq@pdftex@bold{\CJKbold}%
\def\jlreq@pdftex@nobold{\CJKnormal}%


%. ----------------------------------------------- font profile (P4)
% 縦組みグリフ選択・位置補正のデータ源。クラスオプション
% pdftex_fontset（ipaex-type1|ipa|custom）既定 ipaex-type1:
%   ipaex-type1 -> jlreq-pdftex-fonts-ipaex.def（縦字形はipaexm/ipaexg
%                  のvertから生成した補助縦TTF; 横書きはType1平面）
%   ipa         -> jlreq-pdftex-fonts-ipa.def（ipam/ipag由来）
%   custom      -> pdftex_fontprofile=<file>（必須; 指定が無ければ
%                  その旨のエラーで停止——10pt明朝表への黙った
%                  fallbackはしない）
% profile の内容（make_pdftex_fonts.py が生成）:
%   \jlreqpdf@fontprofile@(mc|gt)@shards / @tfm@<n> / @enc@<n>
%   \pdfmapline{...}（補助縦TTFの埋め込み）
%   \jlreqpdf@vglyph@<HEXcp>{{sub}{adv}{vorg}{ink}{shard}{slot}{uni}}
%   \pdfglyphtounicode{jlreqvXXXX}{...}（文字抽出契約）
%   \pdfgentounicode=1
\def\jlreqpdf@profile@file{}%
\ifx d\jlreq@engine
  \@ifundefined{jlreq@pdftex@fontset}{\def\jlreq@pdftex@fontset{ipaex-type1}}{}%
  % \pdfstrcmp: byte-wise (a plain \ifx compares only the first token
  % pair of the macro expansion -- see the fontopt note above).
  \ifnum\pdfstrcmp\expandafter{\csname jlreq@pdftex@fontset\endcsname}{custom}=0 \relax
    \@ifundefined{jlreq@pdftex@fontprofile}{%
      \PackageError{jlreq-pdftex}{%
        pdftex_fontset=custom requires pdftex_fontprofile}{%
        The~fontset~`custom'~needs~a~profile~file~generated~by\MessageBreak
        `make_pdftex_fonts.py~--fontset~custom~--mincho~<TTF>~--gothic~<TTF>'.\MessageBreak
        Pass~the~generated~profile~via~the~class~option\MessageBreak
        pdftex_fontprofile=<file>.~No~silent~fallback~is~performed.\MessageBreak
        \@ehc}%
    }{%
      \edef\jlreqpdf@profile@file{\csname jlreq@pdftex@fontprofile\endcsname}%
    }%
  \else
    \ifnum\pdfstrcmp\expandafter{\csname jlreq@pdftex@fontset\endcsname}{ipa}=0 \relax
      \def\jlreqpdf@profile@file{jlreq-pdftex-fonts-ipa.def}%
    \else
      \def\jlreqpdf@profile@file{jlreq-pdftex-fonts-ipaex.def}%
    \fi
  \fi
\fi
% tate でプロファイルが無い/読めない場合は縦グリフデータ不足として
% 明示エラー（横組みだけならプロファイル無しで動く: 補助縦フォントは
% 縦組みの要求するデータであり、横組み文書に要求しない）。
\ifx\jlreqpdf@profile@file\@empty
  \if@tate
    \PackageError{jlreq-pdftex}{%
      tate typesetting needs a pdfTeX font profile}{%
      The~vertical~glyph~data~(profile~.def~+~aux~vertical~TTF/TFM/enc)\MessageBreak
      is~required~for~tate.~Build~it~with~`make~pdftex-fonts'~(built-in\MessageBreak
      fontsets)~or~`make_pdftex_fonts.py~--fontset~custom'~(custom~fonts).\MessageBreak
      yoko-only~documents~do~not~need~it.\MessageBreak
      \@ehc}%
  \fi
\else
  % Search order: (1) the repo build directory (fonts/pdftex/ -- the
  % working-tree location of `make pdftex-fonts'), (2) the bare name via
  % kpathsea (TEXMF/tex/latex/jlreq after `make install'/'make tds';
  % a user-supplied pdftex_fontprofile=<path> resolves directly here).
  \IfFileExists{fonts/pdftex/\jlreqpdf@profile@file}{%
    \input{fonts/pdftex/\jlreqpdf@profile@file}%
  }{%
    \IfFileExists{\jlreqpdf@profile@file}{%
      \input{\jlreqpdf@profile@file}%
    }{%
      \PackageError{jlreq-pdftex}{%
        font profile file \jlreqpdf@profile@file\space is missing}{%
      The~pdfTeX~backend~cannot~find~the~font~profile~\MessageBreak
      \jlreqpdf@profile@file.\MessageBreak
      Run~`make~pdftex-fonts'~in~the~jlreq~source~tree~to~build~the\MessageBreak
      built-in~profiles,~or~install~the~profile~for~your~fontset\MessageBreak
      (installed~profiles~live~in~tex/latex/jlreq).\MessageBreak
      \@ehc}%
    }%
  }%
\fi

% tate + プロファイルに縦グリフ表（vglyph）が無い場合: 縦組みに必要な
% データが profile に存在しない。黙って回転代用しない（plan: tateで
% profile不足なら生成方法付きエラー）。横組みならここを通らない。
\if@tate
  \@ifundefined{jlreqpdf@fontprofile@mc@tfm@0}{%
    \PackageError{jlreq-pdftex}{%
      the font profile has no vertical glyph data (tate)}{%
    The~loaded~profile~contains~no~aux~vertical~font~shards.\MessageBreak
    Regenerate~the~profile~with~`make_pdftex_fonts.py~--fontset~custom\MessageBreak
    --mincho~<TTF>~--gothic~<TTF>~--profile~<file>'~so~the~vertical\MessageBreak
    forms~are~built~into~the~profile.~Yoko-only~documents~may~keep~a\MessageBreak
    profile~without~vertical~data.\MessageBreak
    \@ehc}%
  }{}%
\fi
% 縦字形の実フォント選択: 現在の CJK family に追従して mc/gt 各シャード
% の補助TFMへ切替える（rules の \jlreqpdf@glyph@tate@vert が
% \jlreqpdf@auxfont を使い、シャード番号は \jlreqpdf@vg@shard）。
% family 判定は CJK.sty の現在値 \CJK@family（\usefont の選択に使われ
% るもの; ipaex-type1 では ipxm/ipxg, ipa プリセットでは mc/gt）と
% \gtdefault の比較: ゴシック系 == \gtdefault。プロファイル表の
% mc/gt 軸はこの論理判定で一対一に対応する。
\def\jlreqpdf@aux@fam{mc}%
\def\jlreqpdf@auxfont@select#1{%
  \font\jlreqpdf@auxtok=\csname jlreqpdf@fontprofile@\jlreqpdf@aux@fam @tfm@#1\endcsname\relax
  \jlreqpdf@auxtok
}
\def\jlreqpdf@auxfont{%
  \ifx\CJK@family\gtdefault
    \def\jlreqpdf@aux@fam{gt}%
  \else
    \def\jlreqpdf@aux@fam{mc}%
  \fi
  \jlreqpdf@auxfont@select{\jlreqpdf@vg@shard}%
}
%. ------------------------------------------- shims / direction / state
% \inhibitglue (P3): real one-boundary suppression. Sets the rules
% machinery's interlock so the NEXT eligible CJK boundary's JFM/auto
% skip is suppressed ONCE (the emitter consumes the flag at the first
% boundary it serves -- including the CJK->LA boundary the peek
% machinery detects). Paragraph/box/math starts re-initialize the flag
% (everypar / the frame push / the math entry), so a stale token never
% leaks into a later paragraph.
\protected\def\inhibitglue{\global\jlreqpdf@inhibit=1 }

% P5: live local direction (plan Approach-5). \jlreqpdf@dir (rules.sty
% frame tuple, 0=yoko/1=tate) is group-local state: the main document
% direction seeds it from \if@tate at begin document (and restores it
% after each page shipout via the same seed, below), the box factory
% and the page-direction switch change it inside their groups, and the
% frame push/pop carries it across box boundaries. These conditionals
% read the CURRENT frame direction -- jlreq.cls's \jlreq@ifydir/@iftdir
% alias them (cls d-branch), so all class callers become live.
\protected\def\jlreqpdftex@ifydir{%
  \ifnum\jlreqpdf@dir=0 \expandafter\@firstoftwo \else \expandafter\@secondoftwo \fi}
\protected\def\jlreqpdftex@iftdir{%
  \ifnum\jlreqpdf@dir=1 \expandafter\@firstoftwo \else \expandafter\@secondoftwo \fi}
% direction seeding: main-document direction. Called at begin document
% and re-run after each page shipout (the page builder flattens groups;
% re-seeding keeps the flag in sync with \if@tate for plain pages).
% \jlreqpdf@setmaindir must be idempotent and group-free.
\def\jlreqpdf@setmaindir{%
  \if@tate \global\jlreqpdf@dir=1 \else \global\jlreqpdf@dir=0 \fi}
\AtBeginDocument{\jlreqpdf@setmaindir}%

%. ---------------------------------------- direction box factory (P5)
% \jlreqpdf@yokobox{<body>} / \jlreqpdf@tatebox{<body>}: the backend-
% owned box factory for local direction switches. Contract (plan §5):
%   * typesets <body> ONCE, in a box whose frame direction is yoko /
%     tate respectively; the surrounding direction is restored after;
%   * cross-direction embedding is normalized to the plan geometry:
%     a yoko box (w,h,d) placed upright in a tate frame advances h+d,
%     with cross extent h' = w/2, d' = w - h' (basic normalization;
%     exact arithmetic, no slack);
%   * in the SAME direction as the current frame, the box is returned
%     unchanged (identity, no extra wrapper);
%   * the factory's boxes carry the direction in the frame state while
%     they are built; for register \copy/\box re-use the direction is
%     whatever the current frame is at unboxing time (pdfTeX has no box
%     attributes; the private-query helper below enforces honesty).
% In the shipout-rotation model (T1) the inner frame of a tate document
% is horizontal: a "tatebox" body is typeset as a normal horizontal
% paragraph (the glyphs self-rotate via the rules glyph layer) and a
% "yokobox" body likewise; the geometric transform for the cross case
% is therefore applied only when the OUTER frame is the opposite of the
% requested one, as explicit box arithmetic (\kern/\raise + rotatebox),
% mirroring pTeX's automatic yoko-in-tate embedding:
%   anchor A, body B(w,h,d) upright:
%     advance = h+d, cross: ht=w/2 dp=w-h/2, B's baseline at A.
\newbox\jlreqpdf@dirbox
\long\def\jlreqpdf@yokobox#1{%
  \ifnum\jlreqpdf@dir=0
    % already yoko: identity (single typeset pass, no wrapper)
    #1%
  \else
    % yoko body inside a tate frame: normalized upright embedding.
    % Guard the rules frame machinery for the measurement pass (this is
    % a backend-internal box, not a semantic boundary).
    \global\advance\jlreqpdf@nest1
    \global\jlreqpdf@dir=0
    \setbox\jlreqpdf@dirbox=\hbox{{#1}}%
    \global\jlreqpdf@dir=1
    \global\advance\jlreqpdf@nest-1
    \jlreqpdf@embed@yoko@in@tate
  \fi}
% \jlreqpdf@yokobox@strut{<ht>}{<dp>}{<body>}: like \jlreqpdf@yokobox but
% the measured body box's height/depth are SET to <ht>/<dp> before the
% embedding arithmetic. pTeX's tcy pins the body's ht+dp at 1zw via a
% strut rule whose extent the (pTeX-metric) digits never exceed; the
% pdfTeX latin metrics can exceed .5zw halves, so the pinning is done on
% the BOX DIMS directly (content may overhang the body box -- boxes do
% not clip, and the outer box's ht/dp/wd are still the normalized values,
% matching uplatex's showbox: outer ht=dp=w/2, advance=ht+dp=1zw).
\long\def\jlreqpdf@yokobox@strut#1#2#3{%
  \ifnum\jlreqpdf@dir=0
    #3%
  \else
    \global\advance\jlreqpdf@nest1
    \global\jlreqpdf@dir=0
    \setbox\jlreqpdf@dirbox=\hbox{{#3}}%
    \global\jlreqpdf@dir=1
    \global\advance\jlreqpdf@nest-1
    \ht\jlreqpdf@dirbox=#1\relax
    \dp\jlreqpdf@dirbox=#2\relax
    \jlreqpdf@embed@yoko@in@tate
  \fi}
\long\def\jlreqpdf@tatebox#1{%
  \ifnum\jlreqpdf@dir=1
    % already tate: identity
    #1%
  \else
    % tate body inside a yoko frame: the body is typeset horizontally
    % (inner frame of the rotation model); its glyphs must read as a
    % vertical run in the final yoko page, so the run is rotated 90deg
    % CCW and the advance is normalized to the body's cross extent.
    \global\advance\jlreqpdf@nest1
    \global\jlreqpdf@dir=1
    \setbox\jlreqpdf@dirbox=\hbox{{#1}}%
    \global\jlreqpdf@dir=0
    \global\advance\jlreqpdf@nest-1
    \jlreqpdf@embed@tate@in@yoko
  \fi}
% yoko-in-tate exact embedding (the tcy primitive; also the generic
% factory path). Body = \box\jlreqpdf@dirbox (w,h,d). Uses the SAME
% graphicx \rotatebox{90} bbox normalization the tate glyph renderer
% relies on: \rotatebox{90}{B} yields wd=h+d, ht=w, dp=0, with B's
% baseline at x=ht(B) inside the result (measured: rot4 probe).
\def\jlreqpdf@embed@yoko@in@tate{%
  % save the body's geometry FIRST: \rotatebox's argument \box-empties
  % \jlreqpdf@dirbox, so w/h/d must not be read after the rotation.
  \jlreqpdf@emb@w=\wd\jlreqpdf@dirbox
  \jlreqpdf@emb@h=\ht\jlreqpdf@dirbox
  \jlreqpdf@emb@d=\dp\jlreqpdf@dirbox
  \setbox\@tempboxa=\hbox{\rotatebox{90}{\box\jlreqpdf@dirbox}}%
  % \box\@tempboxa: wd=h+d, ht=w, dp=0; its left edge = B's TOP, and B's
  % baseline sits at x=ht(B) inside the result (measured: rot4 probe).
  % Shift so B's baseline lands on the outer reference x=0 (B's height
  % then hangs into the previous cell, exactly pTeX's anchor mapping:
  % uplatex PDF bbox shows digit baseline = advance-slot top) and the
  % cross extent (B's width) is centered on the tate baseline.
  \setbox\@tempboxa=\hbox{%
    \kern-\jlreqpdf@emb@h
    \lower.5\jlreqpdf@emb@w
    \box\@tempboxa}%
  % advance = h+d of the body (pTeX's yoko-in-tate advance; with the tcy
  % rule strut ht+dp = 1zw). The kern makes the NATURAL width d only, so
  % the advance is set EXPLICITLY (no slack; matches uplatex showbox:
  % outer box wd = ht_B + dp_B).
  \wd\@tempboxa=\dimexpr\jlreqpdf@emb@h+\jlreqpdf@emb@d\relax
  % cross extent: the body's width split evenly around the tate baseline
  % (pTeX dirbox normalization; uplatex showbox: ht=dp=w/2)
  \ht\@tempboxa=\dimexpr.5\jlreqpdf@emb@w\relax
  \dp\@tempboxa=\dimexpr\jlreqpdf@emb@w-.5\jlreqpdf@emb@w\relax
  \box\@tempboxa}
\newdimen\jlreqpdf@emb@w
\newdimen\jlreqpdf@emb@h
\newdimen\jlreqpdf@emb@d
% tate-in-yoko exact embedding: the tate run (built horizontally in
% the inner frame) rotated CCW so it reads top-to-bottom in the yoko
% page; advance = the body's cross extent, cross = its run length.
\def\jlreqpdf@embed@tate@in@yoko{%
  \setbox\@tempboxa=\hbox{\rotatebox{90}{\box\jlreqpdf@dirbox}}%
  \box\@tempboxa}
% \jlreqpdf@boxdir{<box register>}: private query helper. pdfTeX has no
% box-direction attribute: a box built by the factory is only known to
% be direction-tagged while it is being built. Once the box is a bare
% register, its interior direction CANNOT be derived. This helper is
% the plan's safety contract: it STOPS with ClassError for any box not
% currently known (no silent yoko fallback), and returns the direction
% only for boxes recorded by the factory in the same group scope.
% Normal jlreq documents never hit it: every internal caller uses the
% factory helpers above.
\def\jlreqpdf@boxdir#1{%
  \ClassError{jlreq}{pdfTeX~backend:~direction~of~an~unknown~box~cannot~be~queried}{%
    pdfTeX~has~no~box-direction~attribute.~A~box~is~direction-tagged~only\MessageBreak
    while~the~backend~factory~(\noexpand\jlreqpdf@yokobox/\noexpand\jlreqpdf@tatebox)\MessageBreak
    builds~it.~Use~the~factory~instead~of~querying~raw~registers.\MessageBreak
    \@ehc}%
  % error recovery: assume the current frame direction (never a silent
  % yoko fallback -- the error above has already fired)
  \ifnum\jlreqpdf@dir=0 yoko\else tate\fi}

% \lastnodechar (P3): a REAL scalar maintained by the rules machinery
% (\jlreqpdf@lastnodechar: set to the codepoint at each observed CJK
% glyph, -1 at paragraph/box boundaries). jlreq.cls's own
% \jlreq@lastnodechar counter is aliased to the same register in the
% cls d-branch (a count is not \let-aliasable for assignment, so the
% cls wires \jlreq@lastnodechar as the register itself -- see the cls
% edit), so legacy readers (\jlreq@fixjfm, \tatechuyoko) see live
% values and cls assignments (zenkaku-space `　) stay visible to both.
\newcount\jlreqpdftex@lastnodechar
\jlreqpdftex@lastnodechar=-1

% M4/M5 pending APIs: fail loudly at use time, not silently.
\def\jlreqpdftex@pending#1{%
  \ClassError{jlreq}{pdfTeX~backend:~#1~is~not~implemented~yet.}{%
    This~feature~is~planned~for~a~later~milestone~of~the~pdfTeX~backend.\MessageBreak
    See~docs/pdftex-compatibility.md~for~the~current~status.\MessageBreak
    \@ehc}%
}

%. --------------------------------------------------- math (B19, M6)
% pTeX 系の \DeclareSymbolFont{mincho}/\jfam は pdfTeX には無いため，
% 数式内和文は「テキスト字体のボックス」で供給する
% （docs/pdftex-audit.md B19 の設計指示どおり）．\mathmc/\mathgt 本体の
% 宣言は enablejfam 時に jlreq.cls 側が行う（disablejfam では未定義＝
% (u)pTeX と同じ意味論）．
% \jlreq@pdftex@mathja{<mc|gt>}{<本文>}:
%   数式内: \mathchoice で text/script/scriptscript のサイズを切り替え，
%     対応サイズの \hbox に本文を \mcfamily/\gtfamily で組む．\hbox 内は
%     テキストモードなので CJK アクティブ文字→組版ルール機構（ペアグルー・
%     禁則）がそのまま働き，直打入力和文との整合も取れる．
%   数式外: 単に {\<fam>family 本文} に展開する（数式外 \mathmc は
%     (u)pTeX ではエラーだが，ここでは寛容にフォント切替として扱う）．
\def\jlreq@pdftex@mathja#1#2{%
  \ifmmode
    \def\jlreq@pdftex@mathja@fam{#1}%
    \def\jlreq@pdftex@mathja@body{#2}%
    \mathchoice
      {\jlreq@pdftex@mathja@box{\f@size}}%
      {\jlreq@pdftex@mathja@box{\f@size}}%
      {\jlreq@pdftex@mathja@box{\sf@size}}%
      {\jlreq@pdftex@mathja@box{\ssf@size}}%
  \else
    {\csname #1family\endcsname #2}%
  \fi
}
% #1 = サイズ指定マクロ（\f@size/\sf@size/\ssf@size；pt省略数値を展開する）
\def\jlreq@pdftex@mathja@box#1{%
  % backend-internal box: guard the frame machinery (P3). The everyhbox
  % hook sees the nest count and stays a no-op inside.
  \global\advance\jlreqpdf@nest1
  \hbox{%
    \fontsize{#1}{#1}\selectfont
    \csname\jlreq@pdftex@mathja@fam family\endcsname
    % ボックス先頭は parbdd 相当: lastclass=93（中立）でペアグルー抑制し，
    % 直前文脈の pending 禁則ペナルティはボックス内へ持ち込まない
    \global\jlreqpdf@lastclass=93 \global\jlreqpdf@pend=0
    \jlreq@pdftex@mathja@body
  }%
  \global\advance\jlreqpdf@nest-1
  % 数式は欧文境界（peek@lat と同じく lastclass=27 に戻す: jlreq.cls の
  % 「数式は欧文とみなす」仕様整合）
  \global\jlreqpdf@lastclass=27
}

%. ------------------------------------------- kanji numerals (\kansuji)
% pTeXの\kansujiに相当するプリミティブはpdfTeXには無い．uplatex/platexでの
% 実測（0–1000000をtypeout照合）により，pTeXの仕様は「十進の各桁を
% 〇一二三四五六七八九に置き換える」桁置換であり（10→一〇，100→一〇〇，
% 2025→二〇二五），十・百・千の位取りは行わない．0→〇，負数→空．
% これを完全展開可能なマクロで再現する．
%
% always-on CJK下では和文リテラル（UTF-8活字化バイト列）を\edefや素の
% \writeで展開するとCJK内部の条件分岐（\CJK@XXX）が破綻するため，字形
% への置換は組版時まで遅延させる設計:
%  * \jlreq@kjczero..\jlreq@kjcnine : 各桁の生文字マクロ（UTF-8リテラル）．
%  * \jlreq@kansuji@digit{<d>} : 1桁印字．\protectedなので\edef/\write/
%    \mark/\typeoutのすべてで凍結され，TOC・柱・見出しラベルを安全に
%    通過する（組版時に展開されて生文字を出力）．
%  * \jlreq@pdf@kansuji{<num>} : 完全展開可能．<num>は\numexpr式または
%    単一トークン（\c@chapter等）．展開結果は\jlreq@kansuji@digitの列．
%    jlreq.clsの\jlreq@Kanji（d側）からカウンタ名経由で呼ばれる．
%  * \jlreq@pdf@kansuji@run{<printer>}{<num>} : プリンタ差替口．テストが
%    \detokenize系プリンタを渡してログ照合に用いる．
\def\jlreq@kjczero{〇}
\def\jlreq@kjcone{一}
\def\jlreq@kjctwo{二}
\def\jlreq@kjcthree{三}
\def\jlreq@kjcfour{四}
\def\jlreq@kjcfive{五}
\def\jlreq@kjcsix{六}
\def\jlreq@kjcseven{七}
\def\jlreq@kjceight{八}
\def\jlreq@kjcnine{九}
\protected\def\jlreq@kansuji@digit#1{%
  \ifcase#1 \jlreq@kjczero\or \jlreq@kjcone\or \jlreq@kjctwo\or \jlreq@kjcthree\or
    \jlreq@kjcfour\or \jlreq@kjcfive\or \jlreq@kjcsix\or \jlreq@kjcseven\or
    \jlreq@kjceight\or \jlreq@kjcnine\fi}
\def\jlreq@pdf@kansuji#1{\jlreq@pdf@kansuji@run\jlreq@kansuji@digit{#1}}
\def\jlreq@pdf@kansuji@run#1#2{%
  \expandafter\jlreq@pdf@kansuji@norm\expandafter#1\expandafter{\the\numexpr#2\relax}}
% #1=プリンタ，#2=符号付き10進文字列（\the\numexpr済み）．負数は空．
\def\jlreq@pdf@kansuji@norm#1#2{%
  \ifnum#2<\z@\else\jlreq@pdf@kansuji@loop#1#2\jlreq@pdf@kansuji@stop\fi}
% 再帰呼出しは \expandafter で自身の \fi を先に閉じる（さもないと次桁ではなく
% \fi が #2 として拾われて無限再帰になる，定番の罠）．
\def\jlreq@pdf@kansuji@loop#1#2{%
  \ifx#2\jlreq@pdf@kansuji@stop
  \else
    #1{#2}%
    \expandafter\jlreq@pdf@kansuji@loop\expandafter#1%
  \fi}
\def\jlreq@pdf@kansuji@stop{\jlreq@pdf@kansuji@stop}

%. ------------------------------- label key normalizer (P9, plan §9.1)
% 日本語ラベル key の対称正規化。常時CJK（UTF8 byte 群がアクティブ）の
% pdfTeX では、\label{日本語} の key は \csname r@<key>\endcsname
% （kernel \@kernel@sref 等）で裸展開され、byte マクロ内部の \global・
% \futurelet が \csname 内に混入して "Missing \endcsname" になる
% （実測: trace-mwe/probe33 の l.5/l.2）。CJK の byte マクロは
% \ifx\protect\@typeset@protect 分岐で「\protect がタイプセット保護の
% 間は自らを \noexpand する」契約なので、kernel の \protected@write /
% \protected@edef と同じ仕組みで展開を先導すると生 byte が残る:
%   (1) \protected@edef 系で key を一度「凍結」すると、UTF8 byte は
%       catcode 12/13 のまま文字列化された byte 列になる
%       （実測 M16: \let\protect\@unexpandable@protect + \edef で
%        日本語ラベル が同一 byte 列に凍結される）。
%   (2) \detokenize{<凍結済み列>} は catcode を 12 に揃えるだけで
%       byte は一切変えない（実測 M17/M21: 2 回適用で同一、pdfstrcmp 0）。
%   (3) catcode 12 の byte 列は \csname 構成でも安全（実測 M31/M33/
%       M34: gdef\csname r@<detok列> の定義・参照が丸ごと成立）。
% よって正規化器は「\detokenize で key 全体を同一 byte 列化」である。
% これは ASCII key に対しては完全な恒等変換（aux の ASCII \newlabel 行は
% byte 不変、実測 probe41: \newlabel{sec:top} が1 byte 単位で不変）。
% マクロ label（\label{\mylabelmacro}）も \detokenize 前に
% \protected@edef の保護下で通常どおり展開されるため意味が変わらない
% （kernel \label の書込経路と同一条件）。
% 対象は write（\label 系の key 部）・read（aux の \newlabel 行）・
% query（\ref 系の key）の3点で全て同じ正規化を通す（対称性）。
\long\def\jlreqpdf@labelkey#1{%
  \begingroup
    \let\protect\@unexpandable@protect
    % 段階1: 通常マクロ・カウンタは従来どおり展開し、UTF8 byte は
    % CJK byte マクロの保護分岐（\noexpand<byte>）で凍結する。
    % （実測 M16: この条件下の \edef で日本語ラベル が同一 byte に凍結）
    \protected@edef\jlreqpdf@labelkey@res{#1}%
    % 段階2: catcode を 12 に揃える（byte は不変）。\detokenize は引数を
    % 展開しないため、段階1で展開を済ませてから適用する
    \protected@edef\jlreqpdf@labelkey@res{\detokenize\expandafter{\jlreqpdf@labelkey@res}}%
  \expandafter\endgroup
  \expandafter\def\expandafter\jlreqpdf@labelkey@out\expandafter{\jlreqpdf@labelkey@res}%
}
% ↑ 定義系（非展開）入口: 結果を \jlreqpdf@labelkey@out に返す。
% 段階1で user macro（\mylabel 等）は kernel \label の書込経路と同じ
% 条件で展開され、UTF8 byte は凍結。段階2で csname-safe 化する。
\long\def\jlreqpdf@labelkey@write#1#2{%
  % #1 = \write 出力先（\@auxout 等; kernel protected@write と同じ
  %     呼び出し規約）, #2 = 正規化済み key を含む出力本体
  \protected@write#1{}{#2}%
}

%. ----------------------------------------------------------- tate (T1..T2)
% 出荷時回転（shipout rotation）: 本文ボックス(\@outputbox)を時計回り90°
% 回転して出す。柱・ノンブル・フッタはカーネル既定の横組み機構で出すが、
% 縦組みでは家具行の幅は段長（\textwidth、内側枠組み = 送り方向）ではなく
% 版面巾(\textheight、内側枠組み総高 = 最終枠巾)にする必要がある
% （uplatex 対照で確立）。T1では家具を簡易ラップしていたが、T2で
% \@outputpage を完全オーバーライドして家具を版面巾に揃える。
% NOTE: the \@outputpage body below contains \if@newlist (a \newif conditional
% token).  A plain `\if@tate ... \fi' wrapper would mis-skip when tate is
% false: TeX's conditional skip counts \if@newlist as an open, EOF hits ->
% "Incomplete \iffalse".  The \expandafter\@firstofone/\@gobble idiom closes
% the conditional BEFORE the block is read as a macro argument.
% P5 page-direction flag: theindex (and complements' theindex_yoko) typeset
% real yoko LOGICAL pages inside a tate document. The page-level direction
% is this flag: a page ships ROTATED iff \if@tate AND the flag is 1 (the
% tate default). \jlreqpdf@pagedir{<0|1>} sets the direction for the page
% currently being built (the shipout reads it); it is the interface the
% future output-routine thinning (P7) keeps. Pages flipped by the flag
% must be flushed first (the caller's \clearpage) so the flag never
% applies retroactively to a half-built tate page.
\newcount\jlreqpdf@pagedir@count \global\jlreqpdf@pagedir@count=1
\def\jlreqpdf@pagedir@restore{\global\jlreqpdf@pagedir@count=1 }%
\def\jlreqpdf@pagedir#1{\global\jlreqpdf@pagedir@count=#1\relax}%
\if@tate\expandafter\@firstofone\else\expandafter\@gobble\fi
  {\AtBeginDocument{%
    \expandafter\let\expandafter\jlreqpdf@saved@outputpage\csname @outputpage\endcsname
    \expandafter\def\csname @outputpage\endcsname{%
      \UseHook {build/page/before}%
      \begingroup
        \language\document@default@language
        \@resetactivechars
        \global\let\@@if@newlist\if@newlist
        \global\@newlistfalse
        \@parboxrestore
        \UseHook {build/page/reset}%
        \let \protect \noexpand
        \shipout \vbox{%
          \set@typeset@protect
          \aftergroup \endgroup
          \aftergroup \set@typeset@protect
        \if@specialpage
          \global \@specialpagefalse
          \@nameuse {ps@\@specialstyle}%
        \fi
        \if@twoside
          \ifodd\count\z@
            \let \@thehead \@oddhead
            \let \@thefoot \@oddfoot
            \let \@themargin \oddsidemargin
          \else
            \let \@thehead \@evenhead
            \let \@thefoot \@evenfoot
            \let \@themargin \evensidemargin
          \fi
        \fi
        \reset@font
        \normalsize
        \normalsfcodes
        \let \label \@gobble@with@sphack@om
        \let \index \@gobble@with@sphack@som
        \let \glossary \@gobble@with@sphack@om
        \baselineskip \z@skip
        \lineskip \z@skip
        \lineskiplimit \z@
          \@begindvi
          \vskip \topmargin
          \moveright\@themargin \vbox {%
            \setbox\@tempboxa \vbox to\headheight {%
              \vfil
              \pdfannot@link@off@@
              \UseTaggingSocket{build/page/header}{}%
                {
                  \color@hbox
                    \normalcolor
                    \hb@xt@ \textheight {\@thehead }%
                  \color@endbox
                }
              \pdfannot@link@on@@
            }
            \dp \@tempboxa \z@
            \box \@tempboxa
            \vskip \headsep
            \ifnum\jlreqpdf@pagedir@count=1
              \hbox{\rotatebox{-90}{\box\@outputbox}}%
            \else
              % yoko logical page inside a tate document (theindex):
              % ships UNROTATED -- the inner frame is already its final
              % orientation. Furniture width stays \textheight (the
              % final frame width of a tate page); the logical line
              % extent of the yoko page is \textwidth, narrower, and
              % the surplus is evenly distributed by the galley.
              \box\@outputbox
            \fi
            \baselineskip \footskip
            \pdfannot@link@off@@
            \UseTaggingSocket{build/page/footer}{}%
               {
                  \color@hbox
                     \normalcolor
                     \hb@xt@ \textheight {\@thefoot }%
                   \color@endbox
               }
            \pdfannot@link@on@@
            }
          }
        \global \let \if@newlist \@@if@newlist
        \global \@colht \textheight
        \stepcounter{page}%
        \UseHook {build/page/after}%
    }%
  }}

%. ------------------------------------------------------ tate math (T4)
% 縦組み中の行内数式．ground truth（uplatex 同一ソース bbox 比較）では
% uplatex 縦組数式は数式行ごと CW-90° 回転（寝かせ: 頭右・読み下し）で
% あり，T1 の出荷時 −90° 回転構成はこの向きと一致する（グリフ単位の画素
% プロファイル一致・トークン縦位置完全一致）。よって向きの補正は不要で，
% 唯一の実測ズレはベースライン横位置の定数 δ: 我々の式は CJK 列中心基準で
% 3.43pt@10pt だけ頭側（読冊枠 +x）に寄っていた（行内・\[..\] 表示とも
% 同一の定数）。行内数式 $...$ と \(...\) をキャプチャして内容を自然幅
% ボックスに組み，\raise で内側送り（枠 y 負 = 最終枠の内側）する。
% 表示数式: 自 strip 内の 3.43pt は目立たず現行（GT 一致 strip 配置）の
% まま。$$ 二連はキャプチャ内で cat3-$ 群に入れ替えて TeX 本来の display
% を実行するため、センタリング・改ページ等はカーネル互換のまま変わらない．
% 境界状態: 直前和文→数式の境界は rules の露見ピークのアクティブ$腕が
% peek@lat に誘導（クラス27 意味論は横組みと同一）．ここでは触らない．
% yoko 側への影響: 下記の機構定義は無害な常設マクロ（$ のアクティブ化は
% \if@tate 時の \AtBeginDocument 内のみ）．
% δ: uplatex 同一ソース bbox 実測による較正（T4 解析ログ）
\newdimen\jlreqpdf@tate@mathshift
\newbox\jlreqpdf@tate@mathbox
% cat3-$ トークンのマクロ保持（キャプチャ内で数式へ復帰するため）
\expandafter\let\expandafter\jlreqpdf@dollar@plain\expandafter=$%
% 行内数式の組版: 自然幅 \hbox（\textstyle系）を δ 内側に下げる。
% \mathsurround は jlreq 規定 0pt で、そもそも出荷元の $..$ にも入らない
% （キャプチャ時落ちるが無影響）。#1 はブレース引数（\( 経路と共有）。
\long\def\jlreqpdf@tate@imath#1{%
  % backend-internal box: guard the frame machinery (P3)
  \global\advance\jlreqpdf@nest1
  \setbox\jlreqpdf@tate@mathbox=\hbox{\jlreqpdf@dollar@plain#1\jlreqpdf@dollar@plain}%
  \global\advance\jlreqpdf@nest-1
  \raise-\jlreqpdf@tate@mathshift\hbox{\box\jlreqpdf@tate@mathbox}%
  % 数式は欧文境界（クラス27; peek@lat と同じ意味論）——後続和文との
  % 境界は xkanjiskip になる（tate-math fixture の BOUND-B 実測）。
  \global\jlreqpdf@lastclass=27
}
% $...$ 経路の捕捉: 区切り子=アクティブ$（`$#1$' 署名）本体は上に集約．
\begingroup
\catcode`\$=\active
\long\gdef\jlreqpdf@tate@dollar@grab#1${\jlreqpdf@tate@imath{#1}}%
\endgroup
% アクティブ$ 群: catcode 変更はグループ内局所、定義は \gdef で常設化．
% $$ の区切り子はアクティブ$同士 2 連、cmp は rules.sty 側の露見ピーク腕
% （アクティブ$トークンとの \ifx 一致用）への意味コピー．
\begingroup
\catcode`\$=\active
\gdef${\futurelet\jlreqpdf@tate@mnext\jlreqpdf@tate@dollar}%
\global\let\jlreqpdf@tate@dollar@cmp=$%
% $$ の形式: \jlreqpdf@tate@dollar 経由で呼ばれると入力は
% <$ 2個目><本文><$ 3個目><$ 4個目> なので、パラメタ `$#1$$' で
% 2個目捨て・本文捕捉・終端2個消費になる。
\long\gdef\jlreqpdf@tate@ddollar$#1$${%
  % 表示数式: 従来どおり。cat3-$ の群に入れ替えて本来の $$ を実行
  \begingroup
    \catcode`$=3\relax
    \jlreqpdf@dollar@plain\jlreqpdf@dollar@plain#1\jlreqpdf@dollar@plain\jlreqpdf@dollar@plain
  \endgroup
  \ignorespaces
}%
\endgroup
\def\jlreqpdf@tate@dollar{%
  \ifx\jlreqpdf@tate@mnext\jlreqpdf@tate@dollar@cmp
    \expandafter\jlreqpdf@tate@ddollar
  \else
    \expandafter\jlreqpdf@tate@dollar@grab
  \fi
}
% tate 時だけ $ をアクティブ化し、\( \)（カーネル凍結 cat3-$ マクロで
% アクティブ腕を通らない）をキャプチャ経路に載せ替える。
% （amsmath は \( を上書きしない。math 環境は対象外。）
\if@tate\expandafter\@firstofone\else\expandafter\@gobble\fi
{\AtBeginDocument{%
  \catcode`\$=\active
  \jlreqpdf@tate@mathshift=0.343\jlreq@jareg
  \protected\def\(#1\){\jlreqpdf@tate@imath{#1}}%
}}


%. ------------------------------------ text extraction guarantee (P4)
% profile 読込時に \pdfgentounicode=1 が設定される（補助縦グリフの
% ToUnicode は \pdfglyphtounicode 登録が主体）。文書が後から
% \pdfgentounicode を 0 へ戻した場合、その出力の文字抽出は保証外
% （U+FFFD化・喪失）なので、文書末に明示エラーで診断する（PLAN P4:
% 受入試験も失敗にする）。
\AtEndDocument{%
  \ifnum\pdfgentounicode=\z@
    \PackageError{jlreq-pdftex}{%
      \string\pdfgentounicode=0 breaks the text extraction guarantee}{%
    The~pdfTeX~backend~registers~per-glyph~ToUnicode~maps~for~the~vertical\MessageBreak
    auxiliary~font~slots;~they~only~take~effect~while\MessageBreak
    \string\pdfgentounicode=1.~The~document~set~it~to~0.\MessageBreak
    Restore~\string\pdfgentounicode=1~before~the~end~of~the~document.\MessageBreak
    \@ehc}%
  \fi
}
% NB: jlreq.cls reads us mid-class where @ is a letter; keep it that way.
\makeatletter
