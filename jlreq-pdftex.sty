%%
%% This is file 'jlreq-pdftex.sty'.
%% Experimental pdfTeX backend for the jlreq class (internal use).
%%
%% Loaded by jlreq.cls only when the engine is pdfTeX (engine letter `d').
%% NOT a public package: the loading contract, macro names and behaviour
%% may change at any time while the backend is under development.
%%
%% Milestone M2 scope (see docs/pdftex-compatibility.md):
%%   - glyph output via bxcjkjatype (CJKutf8, ipaex-type1 Type1 fonts)
%%   - always-on CJK state from class load time (metrics measurable)
%%   - \zw/\zh as size-tracking dimen-register macros; \Cht..\Chs declared
%%   - \mcfamily/\gtfamily/\mgfamily via CJKfamily; bold via CJKbold
%%   - horizontal (yoko) only; tate errors loudly
%%   - JFM pair glue / kinsoku / line-end adjustment: M4/M5 (loud errors)
%%

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{jlreq-pdftex}[2026/10/23 v0.2 jlreq pdfTeX backend (experimental, M2+M4)]
\RequirePackage{expl3}
\RequirePackage{jlreq-pdftex-rules}

%. ---------------------------------------------------------- glyph base
% ipaex-type1 : Type 1 subfonts (ipxm/ipxg), embeds everywhere, ToUnicode ok.
% noCJKpunct  : jlreq's own punctuation spacing comes from its JFM rules
%               (M4); CJKpunct's quanjiao kerning would double-apply.
% no `whole'  : the CJK state is turned on here (always-on), not per env.
\RequirePackage[ipaex-type1,noCJKpunct]{bxcjkjatype}

%. --------------------------------------------------- always-on CJK state
% jlreq evaluates Japanese literals at class load time outside any env
% (char-class lists, \contentsname, heading labels, notes). The PoC's
% site-by-site env approach cannot cover that, so uncap CJK's
% encapsulation: make its \global/\active/\local prefixes really global
% and start the UTF8/ipxm state once. State then persists file-wide.
\makeatletter
\let\CJK@global\global
\let\CJK@active\global
\let\CJK@local\global
\CJK@envStart{}{UTF8}{ipxm}%
% \CJK@ignorespaces is NOT set up by envStart when entered directly
% (CJK.sty sets it in \CJKspace, normally called from the env form).
\CJKspace
% CJK's lazy \CJK@input (\makeatother..\makeatletter) may have flipped
% the @ catcode; re-issue before using @-named internals.
\makeatletter

%. --------------------------------------------------------------- units
% pdfTeX has no zw/zh units. Plain TeX's <factor><internal dimen>
% scan-dimen syntax (e.g. 2\baselineskip) still works, so define the
% units as macros expanding to a dimen register. jlreq keeps internal
% \jlreq@zw/\jlreq@zh via \let (= \zw below), so all existing
% `N\jlreq@zw' uses keep working; literal "zw" text inside option
% strings is rewritten by \jlreq@expand@speciallength (cls gate).
\newdimen\jlreq@jareg
\def\zw{\jlreq@jareg}%
\def\zh{\jlreq@jareg}%
% ipaex full-width glyphs are square: 1zh == 1zw == the JA design size.

% \Cht..\Chs are engine-provided under pTeX (plcore.ltx) and LuaTeX-ja
% (lltjfont.sty) but never declared by jlreq.cls; declare them here so
% the cls load-time measurement block works unmodified.
\newdimen\Cht
\newdimen\Cdp
\newdimen\Cwd
\newdimen\Cvs
\newdimen\Chs

%. -------------------------------------------------------------- fonts
% bxcjkjatype[ipaex-type1] already: \mcdefault->ipxm, \gtdefault->ipxg,
% \mgdefault->ipxg, \mcfamily/\gtfamily/\mgfamily as CJKfamily wrappers,
% rmfamily/sffamily/ttfamily hooked to CJKfamily selection. Latin NFSS
% stays a separate axis (no conflation). Nothing to redefine here.

% Bold: no bold IPAex Type1 face exists; bxcjkjatype defaults
% \CJKboldbyembolden ON (PDF 2 Tr), but \bfseries alone does not raise
% \CJK@bold@. Track the current NFSS series and switch CJK bold so
% \sffamily\gtfamily\bfseries headings embolden the kanji too.
\AddToHook{selectfont}{%
  \jlreq@pdftex@trackseries
}
\def\jlreq@pdftex@trackseries{%
  % カーネルの判定と同一（latex.ltxの\bfseries）: 系列名がbで始まる＝太字
  % （b, bx を捕捉．sb は捕捉しない——カーネルと同じ挙動）．
  \if b\expandafter\@car\f@series\@nil
    \expandafter\jlreq@pdftex@bold
  \else
    \expandafter\jlreq@pdftex@nobold
  \fi
}
\def\jlreq@pdftex@bold{\CJKbold}%
\def\jlreq@pdftex@nobold{\CJKnormal}%

%. ------------------------------------------- shims / direction / pending
% pdfTeX inserts no automatic inter-character glue, so \inhibitglue is
% semantically a no-op here (it only suppresses glue that does not
% exist); this is the one safe neutralization. Everything else either
% gets a real definition below or stays loudly undefined.
\let\inhibitglue\relax

% Horizontal only (M7 gate handles tate; the cls gates `tate' itself).
% jlreq's \jlreq@if*(y|t)(dir|box) are redefined via these by the cls.
\protected\def\jlreqpdftex@ifydir{\@firstoftwo}%
\protected\def\jlreqpdftex@iftdir{\@secondoftwo}%

% \lastnodechar does not exist under pdfTeX. jlreq keeps the character
% context in \jlreq@lastnodechar; without a hook chain (M4) there is no
% previous character, so pin it to -1 (which jlreq's \jlreq@fixjfm
% treats as "no JFM glue insertion").
\newcount\jlreqpdftex@lastnodechar
\jlreqpdftex@lastnodechar=-1

% M4/M5 pending APIs: fail loudly at use time, not silently.
\def\jlreqpdftex@pending#1{%
  \ClassError{jlreq}{pdfTeX~backend:~#1~is~not~implemented~yet.}{%
    This~feature~is~planned~for~a~later~milestone~of~the~pdfTeX~backend.\MessageBreak
    See~docs/pdftex-compatibility.md~for~the~current~status.\MessageBreak
    \@ehc}%
}

%. --------------------------------------------------- math (B19, M6)
% pTeX 系の \DeclareSymbolFont{mincho}/\jfam は pdfTeX には無いため，
% 数式内和文は「テキスト字体のボックス」で供給する
% （docs/pdftex-audit.md B19 の設計指示どおり）．\mathmc/\mathgt 本体の
% 宣言は enablejfam 時に jlreq.cls 側が行う（disablejfam では未定義＝
% (u)pTeX と同じ意味論）．
% \jlreq@pdftex@mathja{<mc|gt>}{<本文>}:
%   数式内: \mathchoice で text/script/scriptscript のサイズを切り替え，
%     対応サイズの \hbox に本文を \mcfamily/\gtfamily で組む．\hbox 内は
%     テキストモードなので CJK アクティブ文字→組版ルール機構（ペアグルー・
%     禁則）がそのまま働き，直打入力和文との整合も取れる．
%   数式外: 単に {\<fam>family 本文} に展開する（数式外 \mathmc は
%     (u)pTeX ではエラーだが，ここでは寛容にフォント切替として扱う）．
\def\jlreq@pdftex@mathja#1#2{%
  \ifmmode
    \def\jlreq@pdftex@mathja@fam{#1}%
    \def\jlreq@pdftex@mathja@body{#2}%
    \mathchoice
      {\jlreq@pdftex@mathja@box{\f@size}}%
      {\jlreq@pdftex@mathja@box{\f@size}}%
      {\jlreq@pdftex@mathja@box{\sf@size}}%
      {\jlreq@pdftex@mathja@box{\ssf@size}}%
  \else
    {\csname #1family\endcsname #2}%
  \fi
}
% #1 = サイズ指定マクロ（\f@size/\sf@size/\ssf@size；pt省略数値を展開する）
\def\jlreq@pdftex@mathja@box#1{%
  \hbox{%
    \fontsize{#1}{#1}\selectfont
    \csname\jlreq@pdftex@mathja@fam family\endcsname
    % ボックス先頭は parbdd 相当: lastclass=93（中立）でペアグルー抑制し，
    % 直前文脈の pending 禁則ペナルティはボックス内へ持ち込まない
    \global\jlreqpdf@lastclass=93 \global\jlreqpdf@pend=0
    \jlreq@pdftex@mathja@body
  }%
  % 数式は欧文境界（peek@lat と同じく lastclass=27 に戻す: jlreq.cls の
  % 「数式は欧文とみなす」仕様整合）
  \global\jlreqpdf@lastclass=27
}

%. ------------------------------------------- kanji numerals (\kansuji)
% pTeXの\kansujiに相当するプリミティブはpdfTeXには無い．uplatex/platexでの
% 実測（0–1000000をtypeout照合）により，pTeXの仕様は「十進の各桁を
% 〇一二三四五六七八九に置き換える」桁置換であり（10→一〇，100→一〇〇，
% 2025→二〇二五），十・百・千の位取りは行わない．0→〇，負数→空．
% これを完全展開可能なマクロで再現する．
%
% always-on CJK下では和文リテラル（UTF-8活字化バイト列）を\edefや素の
% \writeで展開するとCJK内部の条件分岐（\CJK@XXX）が破綻するため，字形
% への置換は組版時まで遅延させる設計:
%  * \jlreq@kjczero..\jlreq@kjcnine : 各桁の生文字マクロ（UTF-8リテラル）．
%  * \jlreq@kansuji@digit{<d>} : 1桁印字．\protectedなので\edef/\write/
%    \mark/\typeoutのすべてで凍結され，TOC・柱・見出しラベルを安全に
%    通過する（組版時に展開されて生文字を出力）．
%  * \jlreq@pdf@kansuji{<num>} : 完全展開可能．<num>は\numexpr式または
%    単一トークン（\c@chapter等）．展開結果は\jlreq@kansuji@digitの列．
%    jlreq.clsの\jlreq@Kanji（d側）からカウンタ名経由で呼ばれる．
%  * \jlreq@pdf@kansuji@run{<printer>}{<num>} : プリンタ差替口．テストが
%    \detokenize系プリンタを渡してログ照合に用いる．
\def\jlreq@kjczero{〇}
\def\jlreq@kjcone{一}
\def\jlreq@kjctwo{二}
\def\jlreq@kjcthree{三}
\def\jlreq@kjcfour{四}
\def\jlreq@kjcfive{五}
\def\jlreq@kjcsix{六}
\def\jlreq@kjcseven{七}
\def\jlreq@kjceight{八}
\def\jlreq@kjcnine{九}
\protected\def\jlreq@kansuji@digit#1{%
  \ifcase#1 \jlreq@kjczero\or \jlreq@kjcone\or \jlreq@kjctwo\or \jlreq@kjcthree\or
    \jlreq@kjcfour\or \jlreq@kjcfive\or \jlreq@kjcsix\or \jlreq@kjcseven\or
    \jlreq@kjceight\or \jlreq@kjcnine\fi}
\def\jlreq@pdf@kansuji#1{\jlreq@pdf@kansuji@run\jlreq@kansuji@digit{#1}}
\def\jlreq@pdf@kansuji@run#1#2{%
  \expandafter\jlreq@pdf@kansuji@norm\expandafter#1\expandafter{\the\numexpr#2\relax}}
% #1=プリンタ，#2=符号付き10進文字列（\the\numexpr済み）．負数は空．
\def\jlreq@pdf@kansuji@norm#1#2{%
  \ifnum#2<\z@\else\jlreq@pdf@kansuji@loop#1#2\jlreq@pdf@kansuji@stop\fi}
% 再帰呼出しは \expandafter で自身の \fi を先に閉じる（さもないと次桁ではなく
% \fi が #2 として拾われて無限再帰になる，定番の罠）．
\def\jlreq@pdf@kansuji@loop#1#2{%
  \ifx#2\jlreq@pdf@kansuji@stop
  \else
    #1{#2}%
    \expandafter\jlreq@pdf@kansuji@loop\expandafter#1%
  \fi}
\def\jlreq@pdf@kansuji@stop{\jlreq@pdf@kansuji@stop}

% NB: jlreq.cls reads us mid-class where @ is a letter; keep it that way.
\makeatletter
